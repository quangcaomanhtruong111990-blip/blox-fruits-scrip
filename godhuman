-- 6. Sea 2 & 3: Auto Raid (Buy Chip, Teleport, Clear Islands 1-5)
function FunctionsHandler.RaidController.Run()
    if (ScriptStorage.PlayerData.Level or 0) < 1100 or SeaIndex == 1 then return false end
    if (ScriptStorage.PlayerData.Fragments or 0) >= (Config.Settings.Fragments or 5000) then return false end

    local inRaid = false
    for _, obj in ipairs(workspace["_WorldOrigin"].Locations:GetChildren()) do
        if string.find(obj.Name, "Island ") and (obj.Position - Vector3.zero).Magnitude > 7000 then
            if CaculateDistance(obj.Position) < 2000 then
                inRaid = true
                SetTask("MainTask", "Auto Raid | Clearing " .. obj.Name)
                local mon = GetMonAsSortedRange()[1]
                if mon then
                    CombatController.Attack(mon.Name)
                else
                    TweenController.Create(obj.Position + Vector3.new(0, 80, 0))
                end
                return true
            end
        end
    end

    local hasChip = LocalPlayer.Character:FindFirstChild("Special Microchip") or LocalPlayer.Backpack:FindFirstChild("Special Microchip")
    if not hasChip then
        SetTask("MainTask", "Auto Raid | Buying Chip")
        Remotes.CommF_:InvokeServer("RaidsNpc", "Select", "Flame")
        task.wait(1)
    else
        SetTask("MainTask", "Auto Raid | Starting Raid")
        local RootRaidIsland = ({nil, "CircleIsland", "Boat Castle"})[SeaIndex]
        local RaidIsland = workspace.Map:FindFirstChild(RootRaidIsland) or workspace:FindFirstChild(RootRaidIsland)
        if RaidIsland and RaidIsland:FindFirstChild("RaidSummon2") then
            local btn = RaidIsland.RaidSummon2.Button.Main
            if CaculateDistance(btn.Position) > 20 then
                TweenController.Create(btn.CFrame)
            else
                pcall(function() fireclickdetector(btn.ClickDetector) end)
            end
            return true
        end
    end
    return false
end

