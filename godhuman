function GetMonAsSortedRange()
    local Result = {}
    for _, Mon in ipairs(workspace.Enemies:GetChildren()) do
        if Mon:FindFirstChild("Humanoid") and Mon:FindFirstChild("HumanoidRootPart") and Mon.Humanoid.Health > 0 then
            table.insert(Result, Mon)
        end
    end
    table.sort(Result, function(a, b)
        return CaculateDistance(a.HumanoidRootPart.CFrame) < CaculateDistance(b.HumanoidRootPart.CFrame)
    end)
    return Result
end

CombatController = {
    GRAB_DISTANCE = 350
}

function CombatController.Grab(MobName)
    pcall(function()
        local MidPoint, Count = Vector3.zero, 0
        local MobsTable = {}
        for _, Mon in ipairs(workspace.Enemies:GetChildren()) do
            if Mon.Name == MobName and Mon:FindFirstChild("Humanoid") and Mon:FindFirstChild("HumanoidRootPart") and Mon.Humanoid.Health > 0 then
                Count = Count + 1
                MidPoint = MidPoint + Mon.HumanoidRootPart.Position
                table.insert(MobsTable, Mon)
            end
        end
        if Count > 0 then
            MidPoint = CFrame.new(MidPoint / Count)
            for _, Mon in ipairs(MobsTable) do
                Mon.HumanoidRootPart.CFrame = MidPoint
                Mon.HumanoidRootPart.CanCollide = false
            end
        end
    end)
end

function CombatController.Attack(MobTarget)
    _G.FastAttack = true
    local MobList = typeof(MobTarget) == "table" and MobTarget or { tostring(MobTarget) }

    local TargetMob = nil
    for _, m in ipairs(GetMonAsSortedRange()) do
        if table.find(MobList, m.Name) and m.Humanoid.Health > 0 then
            TargetMob = m
            break
        end
    end

    if TargetMob and TargetMob:FindFirstChild("HumanoidRootPart") then
        local StartFight = os.time()
        while TargetMob and TargetMob:FindFirstChild("Humanoid") and TargetMob.Humanoid.Health > 0 and (os.time() - StartFight < 40) do
            task.wait(0.05)
            if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then break end

            local mobPos = TargetMob.HumanoidRootPart.CFrame * CFrame.new(0, 25, 0)
            TweenController.Create(mobPos)

            if CaculateDistance(TargetMob.HumanoidRootPart.Position) < 50 then
                CombatController.Grab(TargetMob.Name)
                pcall(function()
                    for _, item in ipairs(LocalPlayer.Backpack:GetChildren()) do
                        if item:IsA("Tool") and (item.ToolTip == "Melee" or item.ToolTip == "Sword") then
                            LocalPlayer.Character.Humanoid:EquipTool(item)
                            break
                        end
                    end
                end)
            end
        end
    else
        for _, name in ipairs(MobList) do
            local spawnPos = nil
            for _, region in ipairs(workspace.Enemies:GetChildren()) do
                if region.Name == name and region:FindFirstChild("HumanoidRootPart") then
                    spawnPos = region.HumanoidRootPart.Position
                    break
                end
            end
            if spawnPos then
                TweenController.Create(spawnPos + Vector3.new(0, 30, 0))
            end
        end
    end
end

