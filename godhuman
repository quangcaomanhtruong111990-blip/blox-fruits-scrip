function FunctionsHandler.Saber.Run()
    if SeaIndex ~= 1 or not Config.Items.Saber or (ScriptStorage.PlayerData.Level or 0) < 200 then
        return false
    end
    if ScriptStorage.Backpack.Saber or ScriptStorage.Tools.Saber then
        return false
    end

    local Tasks = Remotes.CommF_:InvokeServer("ProQuestProgress")
    if not Tasks then return false end

    for Index, Value in pairs(Tasks.Plates or {}) do
        if Value == false then
            SetTask("MainTask", "Saber Quest | Touching Plates")
            local plate = workspace.Map.Jungle.QuestPlates:FindFirstChild("Plate" .. Index)
            if plate and plate:FindFirstChild("Button") then
                TweenController.Create(plate.Button.CFrame)
                task.wait(1)
            end
            return true
        end
    end

    if not Tasks.UsedTorch then
        SetTask("MainTask", "Saber Quest | Burning Door with Torch")
        Remotes.CommF_:InvokeServer("ProQuestProgress", "GetTorch")
        task.wait(1)
        Remotes.CommF_:InvokeServer("ProQuestProgress", "DestroyTorch")
        return true
    elseif not Tasks.UsedCup then
        SetTask("MainTask", "Saber Quest | Filling Cup with Water")
