        function MeleeNameMatches(a, b)
            local na, nb = MeleeNormName(a), MeleeNormName(b)
            if na == "" or nb == "" then return false end
            if na == nb then return true end
            if string.find(na, nb, 1, true) or string.find(nb, na, 1, true) then return true end
            -- Khop theo token: "Dark Step Teacher" van tinh la "Dark Step Master",
            -- nhung khong nham lan voi "Sharkman Teacher" (khong trung token nao).
            local ta, tb = MeleeNpcTokens(a), MeleeNpcTokens(b)
            local shared, countA, countB = 0, 0, 0
            for w in pairs(ta) do
                countA = countA + 1
                if tb[w] then shared = shared + 1 end
            end
            for _ in pairs(tb) do countB = countB + 1 end
            if countA > 0 and shared == countA then return true end
            if countB > 0 and shared == countB then return true end
            return false
        end
