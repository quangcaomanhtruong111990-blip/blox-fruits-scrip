                    end
                    return lvlObj.Value
                end
            end
            if ScriptStorage and ScriptStorage.Melees and tonumber(ScriptStorage.Melees[mName]) then
                return tonumber(ScriptStorage.Melees[mName]) or 0
            end
            -- [km53] GetMeleeMastery (dùng riêng cho Godhuman) cũng phải đọc được dòng
            -- mastery trên HUD game, nếu không thì 5 võ phụ cất trong kho luôn = 0.
            if type(ReadMeleeMasteryHud) == "function" then
                local hudVal = 0
                pcall(function()
