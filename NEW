        function TimHop(Reason)
            local cur = game.JobId
            local picked, how = nil, nil

            -- Nguon 1: danh sach server cua chinh game (khong can HTTP, chay duoc tren DT)
            pcall(function()
                local Servers = GetServers() or {}
                local best, bestCnt = nil, 999
                local n = 0
                for jobId, info in pairs(Servers) do
                    if type(jobId) == "string" and jobId ~= "" and jobId ~= cur then
                        n = n + 1
                        local cnt = 0
                        if type(info) == "table" then cnt = tonumber(info.Count) or 0 else cnt = tonumber(info) or 0 end
                        if cnt < bestCnt then
                            best, bestCnt = jobId, cnt
                        end
                    end
                end
                if best then
                    picked = best
                    how = "ServerBrowser(" .. n .. " server, it nguoi nhat = " .. bestCnt .. ")"
                end
            end)

            -- Nguon 2: HTTP public servers (PC executor moi duoc)
            if not picked then
                pcall(function()
                    local req = game:HttpGet(
                        "https://games.roblox.com/v1/games/" ..
                            game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true"
                    )
                    local body = nil
                    pcall(function()
                        body = game:GetService("HttpService"):JSONDecode(req)
                    end)
                    for _, v in ipairs((type(body) == "table" and body.data) or {}) do
