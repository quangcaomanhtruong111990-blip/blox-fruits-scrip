        function QuestManager.RefreshQuest(Self)
            pcall(function()
                local retries = 0
                while not (ScriptStorage and ScriptStorage.PlayerData and ScriptStorage.PlayerData.Level) do
                    pcall(RefreshPlayerData)
                    if not (ScriptStorage and ScriptStorage.PlayerData and ScriptStorage.PlayerData.Level) then
                        local lp = game:GetService("Players").LocalPlayer
                        if lp and lp:FindFirstChild("Data") and lp.Data:FindFirstChild("Level") then
                            if not ScriptStorage.PlayerData then ScriptStorage.PlayerData = {} end
                            ScriptStorage.PlayerData.Level = lp.Data.Level.Value
                        end
                    end
                    if ScriptStorage and ScriptStorage.PlayerData and ScriptStorage.PlayerData.Level then break end
                    task.wait(0.2)
                    retries = retries + 1
                    if retries > 15 then
                        if not ScriptStorage.PlayerData then ScriptStorage.PlayerData = {} end
                        ScriptStorage.PlayerData.Level = 1
                        break
                    end
                end

                local PlayerLevel = (ScriptStorage and ScriptStorage.PlayerData and ScriptStorage.PlayerData.Level) or 1
                local QuestLevelFlag = 0
                local SelectedQuestData = nil
                local SelectedQuestID = nil

                local allQuests = QuestManager.Quests or BuiltInQuests

                for QuestID, QuestDatas in pairs(allQuests) do
                    if not QuestManager.BlacklistedQuestIds or not QuestManager.BlacklistedQuestIds[QuestID] then
                        if QuestDatas and QuestDatas[1] and QuestDatas[1].LevelReq then
                            local req = QuestDatas[1].LevelReq
                            -- Filter quests strictly by current Sea
                            local isSeaMatch = true
                            if SeaIndex == 1 then
                                isSeaMatch = (req < 700)
                            elseif SeaIndex == 2 then
                                isSeaMatch = (req >= 700 and req < 1500)
                            elseif SeaIndex == 3 then
                                isSeaMatch = (req >= 1500)
                            end

                            if isSeaMatch and req <= PlayerLevel and req >= QuestLevelFlag then
                                QuestLevelFlag = req
                                SelectedQuestData = QuestDatas
                                SelectedQuestID = QuestID
                            end
                        end
                    end
                end

                -- Fallback if no sea match found
                if not SelectedQuestData then
                    for QuestID, QuestDatas in pairs(allQuests) do
                        if not QuestManager.BlacklistedQuestIds or not QuestManager.BlacklistedQuestIds[QuestID] then
                            if QuestDatas and QuestDatas[1] and QuestDatas[1].LevelReq then
                                local req = QuestDatas[1].LevelReq
                                if req <= PlayerLevel and req >= QuestLevelFlag then
                                    QuestLevelFlag = req
                                    SelectedQuestData = QuestDatas
                                    SelectedQuestID = QuestID
                                end
                            end
                        end
                    end
                end

                if SelectedQuestData and #SelectedQuestData > 0 then
                    Self.CurrentQuestId = SelectedQuestID
                    -- Deep clone into a new table so we never mutate BuiltInQuests / QuestManager.Quests
                    local clonedQuests = {}
                    for _, qItem in ipairs(SelectedQuestData) do
                        local isSingleBoss = false
                        if qItem.Task then
                            for _, count in pairs(qItem.Task) do
                                if count == 1 then
                                    isSingleBoss = true
                                    break
                                end
                            end
                        end
                        if not isSingleBoss then
                            table.insert(clonedQuests, qItem)
                        end
                    end
                    if #clonedQuests == 0 then
                        clonedQuests = {SelectedQuestData[1]}
                    end
                    Self.CurrentQuests = clonedQuests

                    -- Find NPC Coordinates
                    Self.CurrentNpc = nil
                    local targetReq = clonedQuests[#clonedQuests] and clonedQuests[#clonedQuests].LevelReq or QuestLevelFlag

                    -- 1. Try GuideModule / NpcList
                    if NpcList then
                        for i, v in pairs(NpcList) do
                            if v and v.Levels then
                                for _, v1 in pairs(v.Levels) do
                                    if v1 == targetReq then
                                        if typeof(i) == "Instance" then
                                            Self.CurrentNpc = (i:IsA("Model") and i:GetPivot().Position) or (i:IsA("BasePart") and i.Position)
                                        elseif typeof(i) == "CFrame" then
                                            Self.CurrentNpc = i.Position
                                        elseif typeof(i) == "Vector3" then
                                            Self.CurrentNpc = i
                                        elseif typeof(i) == "string" then
                                            local npcObj = (workspace:FindFirstChild("NPCs") and workspace.NPCs:FindFirstChild(i)) or (game.ReplicatedStorage:FindFirstChild("NPCs") and game.ReplicatedStorage.NPCs:FindFirstChild(i))
                                            if npcObj then
                                                Self.CurrentNpc = (npcObj:IsA("Model") and npcObj:GetPivot().Position) or (npcObj:IsA("BasePart") and npcObj.Position)
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end

                    -- 2. Fallback Built-in NPC Coordinates
                    if not Self.CurrentNpc and Self.CurrentQuestId and BuiltInNpcPositions[Self.CurrentQuestId] then
                        Self.CurrentNpc = BuiltInNpcPositions[Self.CurrentQuestId]
                    end
                end
            end)
        end

        function QuestManager.GetCurrentQuest(Self)
            if not Self.CurrentQuests or #Self.CurrentQuests == 0 then
                Self:RefreshQuest()
            end
            if not Self.CurrentQuests or #Self.CurrentQuests == 0 then
                return nil, Self.CurrentNpc or (Self.CurrentQuestId and BuiltInNpcPositions[Self.CurrentQuestId]), Self.CurrentQuestId, 1, nil
            end

            local pLevel = (ScriptStorage.PlayerData and ScriptStorage.PlayerData.Level) or 1
            local QuestIndex = 1
            if Self.CurrentQuests[2] and Self.CurrentQuests[2].LevelReq and Self.CurrentQuests[2].LevelReq <= pLevel then
                QuestIndex = 2
            end

            local qEntry = Self.CurrentQuests[QuestIndex] or Self.CurrentQuests[1]
            if qEntry and qEntry.Task then
                for Name in pairs(qEntry.Task) do
                    local npcPos = Self.CurrentNpc or (Self.CurrentQuestId and BuiltInNpcPositions[Self.CurrentQuestId])
                    return Name, npcPos, Self.CurrentQuestId, QuestIndex, qEntry.Name
                end
            end
            return nil, Self.CurrentNpc, Self.CurrentQuestId, 1, nil
        end

        function QuestManager.MarkAsCompleted(Self)
            Self.CurrentLevel = Self.CurrentLevel == 2 and 1 or 2
        end

