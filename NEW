        MOB_WORD_GENERIC = {
            pirate = true, marine = true, soldier = true, warrior = true, bandit = true,
            officer = true, guard = true, staff = true, master = true, prisoner = true,
            raider = true, captain = true, commander = true, champion = true, boy = true,
