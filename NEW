                        -- KIỂM TRA ĐÃ TIẾP CẬN BÃI QUÁI HAY CHƯA (Tránh nhận nhầm quest khi đang bay đường dài)
                        -- [km45] scan ca folder Enemies -> chi quet 1 lan / 2s thay vi 20 lan/giay
                        if not hasArrivedAtMob and (not ArriveScanTick or os.clock() - ArriveScanTick >= 2) then
