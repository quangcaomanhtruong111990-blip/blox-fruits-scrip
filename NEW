-- Lan luot thu tung trai cui cho toi khi lay duoc 1 trai ra kho
function TimTraiCuiTrongKho(ChoTraiXau)
    if not RaidUsesStoredFruits() then
        return nil
    end
    if getgenv().IsRaidStarting then
        return nil
    end
    if KhoTraiLastTry and os.clock() - KhoTraiLastTry < 6 then
        return nil
    end
    KhoTraiLastTry = os.clock()

    -- [km47] Mac dinh chi lay trai TRANG. Danh sach kho lay duoc thi loc bang TraiLoaiTrang;
    -- nguon nao khong co ten thi thu cu soa dung danh sach trai trang mac dinh.
    -- [DT3] ChoTraiXau = true (dang thieu DIEM F) -> moi trai deu duoc thu, van loc trai
    -- hang cao (HighTen) va Eatlist o vong lap ben duoi nen khong an mat trai xin.
    local candidates = {}
    local traiKhoKhac = {}
    for _, F in ipairs(TraiTrongKho(true)) do
        if ChoTraiXau or TraiLoaiTrang(F.Name) then
            table.insert(candidates, F.Name)
        else
            table.insert(traiKhoKhac, tostring(F.Name))
        end
    end
    if #candidates == 0 and #traiKhoKhac == 0 then
        for _, Ten in ipairs(TraiCuiTen) do
            table.insert(candidates, Ten)
        end
    end
    if #candidates == 0 and os.time() - (KhoTraiNoWhiteLogged or 0) > 120 then
        KhoTraiNoWhiteLogged = os.time()
        print("[KhoTrai] TRONG KHO KHONG CO TRAI TRANG nao -> khong raid (giu trai xanh/tim/do). " ..
            "Trai trong kho: " .. table.concat(traiKhoKhac, ", "))
        print("[KhoTrai] thay trai trang thieu thi them vao Config.Raid.WhiteFruits")
    end

    local HighTen = {"Kitsune", "Dragon", "Leopard", "Spirit", "Control", "Venom", "Shadow", "Dough", "T-Rex",
        "Mammoth", "Gravity", "Blizzard", "Pain", "Rumble", "Portal", "Phoenix", "Sound", "Spider", "Love", "Buddha"}
    KhoTraiFail = KhoTraiFail or {}
    -- [km43] CHI THU TOI DA 2 TEN MOI LAN GOI (moi ten mat toi da 2.5s cho verify)
    -- -> khong block vong lap chinh hung phut nhu khi thu ca danh sach 1 luc
    local daThu = 0
    while daThu < 2 do
        KhoTraiCursor = (KhoTraiCursor or 0) + 1
        if KhoTraiCursor > #candidates then
            KhoTraiCursor = 1
            KhoTraiFail = {}
            break
        end
        local Ten = candidates[KhoTraiCursor]
        local bo = false
        for _, h in ipairs(HighTen) do
            if string.find(Ten, h) then
                bo = true
            end
        end
        if Config.Items.Eatlist and table.find(Config.Items.Eatlist, Ten) then
            bo = true
        end
        local blocked = KhoTraiFail[Ten]
        if type(blocked) == "number" and blocked > os.time() then
            bo = true
        end
        if not bo then
            daThu = daThu + 1
            if LayTraiKhoRa(Ten) then
                RaidFruitHoldName = Ten
                RaidFruitHoldUntil = os.time() + 1800
                if not table.find(ScriptStorage.IgnoreStoreFruits, Ten) then
                    table.insert(ScriptStorage.IgnoreStoreFruits, Ten)
                end
                print("[KhoTrai] DA lay \"" .. Ten .. "\" ra kho de RAID (giu 30 phut khong cat lai)")
                return {Name = Ten, Type = "Blox Fruit", FromStorage = true}
            end
            KhoTraiFail[Ten] = os.time() + 900
        end
    end
    if not KhoTraiAllFailLogged or os.time() - KhoTraiAllFailLogged > 120 then
        KhoTraiAllFailLogged = os.time()
        print("[KhoTrai] qua " .. tostring(#candidates) .. " ten trai ma chua lay duoc trai cui nao -> " ..
            "bat Config.Configuration.RemoteSpy=true roi TU TAY lay 1 trai ra trong game de log lenh that")
    end
    return nil
end

-- [km40] REMOTE SPY: dat Config.Configuration.RemoteSpy = true roi inject, TU TAY lam
-- chuc nang muon hoc trong game (vi du: di tau/cua ngo sang Sea 3) -> log "[SPY] <ten>: <tham so>"
-- se cho biet chinh xac lenh server nao duoc goi. Bat ra thi LOG RAT DAY, chi bat khi can.
do
    local wrap = (type(newcclosure) == "function") and newcclosure or function(f) return f end
    local okHook, errHook = pcall(function()
        if type(hookmetamethod) ~= "function" or type(getnamecallmethod) ~= "function" then
            print("[SPY] executor khong ho tro hookmetamethod -> khong bat duoc spy")
            return
        end
        local old
        local function fmtArg(a)
            local ta = typeof(a)
            if ta == "Vector3" then
                return string.format("V(%.0f,%.0f,%.0f)", a.X, a.Y, a.Z)
            elseif ta == "CFrame" then
                return string.format("CF(%.0f,%.0f,%.0f)", a.Position.X, a.Position.Y, a.Position.Z)
            elseif ta == "table" then
                local n, ke = 0, {}
                for k, v in pairs(a) do
                    n = n + 1
                    if n <= 5 then
                        ke[#ke + 1] = tostring(k) .. "=" .. tostring(v)
                    end
                end
                return "(table#" .. n .. "){" .. table.concat(ke, ",") .. "}"
            elseif ta == "Instance" then
                return "(" .. a.ClassName .. ")" .. a.Name
            end
            return tostring(a)
        end
        old = hookmetamethod(game, "__namecall", wrap(function(self, ...)
            local isSpy = (type(Config) == "table" and Config.Configuration and Config.Configuration.RemoteSpy)
            local method = nil
            if isSpy then
                pcall(function()
                    method = getnamecallmethod()
                end)
            end
            -- [km43] SPY MO RONG: bat MOI RemoteFunction/RemoteEvent (khong rieng CommF_)
            -- va in ca ket tra ve -> dung de tim lenh "lay trai ra kho cua" that
            if isSpy and (method == "InvokeServer" or method == "FireServer") then
                local la = self
                local okK, isRemote = pcall(function()
                    return la:IsA("RemoteFunction") or la:IsA("RemoteEvent") or la:IsA("UnreliableRemoteEvent")
                end)
                if okK and isRemote then
                    local okN, nm = pcall(function()
                        return la.Name
                    end)
                    local okP, pn = pcall(function()
                        return (la.Parent and la.Parent.Name) or "?"
                    end)
                    local args = { ... }
                    local parts = {}
                    for i = 1, math.min(#args, 6) do
                        parts[i] = fmtArg(args[i])
                    end
                    local ten = tostring(pn) .. "." .. tostring(nm)
                    if method == "InvokeServer" then
                        local okR, res = pcall(function()
                            return old(la, table.unpack(args, 1, #args))
                        end)
                        print("[SPY] " .. ten .. ": " .. table.concat(parts, ", ") .. " ==> " ..
                            (okR and fmtArg(res) or ("LOI " .. tostring(res))))
                        if okR then
                            return res
                        end
                        return nil
                    end
                    print("[SPY] " .. ten .. ": " .. table.concat(parts, ", "))
                end
            end
            return old(self, ...)
        end))
    end)
    if not okHook then
        print("[SPY] hook that bai: " .. tostring(errHook))
    end
end

