        -- [M3] GACHA TRAI NGAY (port "Cousin,Buy" + fallback RF/GachaNetworkRF cua
        -- hub FC4). Ban cu chi co 1 lenh Cousin,Buy va goi MOI CHECK_INTERVAL lan,
        -- bi tu choi thi van goi tiep va im lang -> khong bao gio biet vi sao thung.
        function M3GachaRejected(Value)
            if Value == nil or Value == false then
                return true
            end
            if typeof(Value) == "table" and (Value.Success == false or Value.Error ~= nil) then
                return true
            end
            if typeof(Value) == "string" then
                local low = string.lower(Value)
                if string.find(low, "come back", 1, true) or string.find(low, "quay lai", 1, true)
                    or string.find(low, "later", 1, true) or Value == "" then
                    return true
                end
            end            return false
        end

        -- Tra: ketQua, tenLenh | nil, "ca 2 lenh", ly do
        function M3GachaLan()
            local ok1, resp1 = pcall(function()
