-- Lay 1 trai tu kho ve balo: LoadFruit roi xac minh bang Tool xuat hien that
function LayTraiKhoRa(tenTrai)
    if not (Remotes and Remotes.CommF_) then
        return false
    end
    local lp = game:GetService("Players").LocalPlayer
    if not lp then
        return false
    end
    local tenTool = nil
    pcall(function()
        tenTool = FruitIdToName(tostring(tenTrai))
    end)
    local Truoc = DemTraiVatLy()
    local okCall, resp = pcall(function()
        return Remotes.CommF_:InvokeServer("LoadFruit", tostring(tenTrai))
    end)
    local Got = nil
    -- [km43] verify NGAN (1.2s) vi ham nay chay trong tick cua scheduler:
    -- cho lau thi script dung het viec fam/nhat trai
    local Deadline = os.clock() + 1.2
    repeat
        task.wait(0.1)
        if tenTool and lp:FindFirstChild("Backpack") and lp.Backpack:FindFirstChild(tenTool) then
            Got = tenTool
        elseif DemTraiVatLy() > Truoc then
            Got = "tool trai khac"
        end
    until Got or os.clock() > Deadline
    print("[KhoTrai] LoadFruit \"" .. tostring(tenTrai) .. "\" -> " ..
        (okCall and tostring(resp) or ("LOI:" .. tostring(resp))) ..
        (Got and (" | DA NAM TRONG BALO (" .. tostring(Got) .. ")") or " | van khong co gi"))
    return Got ~= nil
end

