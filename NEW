                            local isNear = false
                            if targetMobPos and CaculateDistance(targetMobPos) <= 350 then
                                isNear = true
                            else
                                local enemies = workspace:FindFirstChild("Enemies")
                                if enemies then
                                    for _, enemy in ipairs(enemies:GetChildren()) do
