        function TweenController.Create(Position)
            -- 1. KIỂM TRA CƠ BẢN
            local Character = game.Players.LocalPlayer.Character
            if not Character or not Character:FindFirstChild("HumanoidRootPart") or not Character:FindFirstChild("Humanoid") then return end
            if not Position or TweenDebounce then return end
            
            -- Chống bay khi đang chết
            if Character.Humanoid.Health <= 0 then return end

            -- [M11] Luc dang RAID: khong bat ki thread nao khac vong raid duoc keo nhan
            -- vat di (day la CHOT DUY NHAT moi lenh bay cua file nay).
            if not M11DuocHanhDong() then
                M11BiChan("TWEEN", Position)
                return
            end
        
            -- Chuyển đổi Position sang CFrame nếu cần
            local TargetCFrame = typeof(Position) ~= "CFrame" and CFrame.new(Position) or Position
            TargetCFrame = CFrame.new(TargetCFrame.Position)
        
            local RootPart = Character.HumanoidRootPart
            local CurrentDist = (RootPart.Position - TargetCFrame.Position).Magnitude
        
            -- 2. CHỐNG GIẬT / CHỐNG CANCEL LIÊN TỤC KHI ĐANG BAY TỚI CÙNG ĐÍCH
            local bayGioT = os.clock()
            if TweenInstance and TweenInstance.PlaybackState == Enum.PlaybackState.Playing then
                if TweenController._CurrentTarget and (TweenController._CurrentTarget.Position - TargetCFrame.Position).Magnitude < 15 then
                    return
                end
                if CurrentDist < 5 then
                    return
                end
                -- [M5] Loop danh (CombatController.Attack) goi Create MOI 0.1s, ma muc dich
                -- xoay vong quanh quai luon doi -> tween bi Cancel roi tao lai 10 lan/giay.
                -- Cancel kich vao handler Completed cua tween CU, handler do dat
                -- AssemblyLinearVelocity = 0 -> nhan vat "dung - chay - dung" = NGAT QUYEN.
                -- Neu tween dang chay moi hon 0.3s va van con xa dich thi KE THUA duong
                -- bay cu, khong lam lai tu dau.
                if
                    CurrentDist > 15 and TweenController._LastCreate and
                        bayGioT - TweenController._LastCreate < 0.3
                 then
                    return
                end
            end
        
            TweenController._CurrentTarget = TargetCFrame
            TweenController._LastCreate = bayGioT
        
            -- 3. XỬ LÝ NOCLIP VÀ GIỮ VỮNG NHÂN VẬT
            pcall(function()
                Character.Humanoid.PlatformStand = true
                for _, name in ipairs({"HumanoidRootPart", "UpperTorso", "LowerTorso", "Torso", "Head"}) do
                    local p = Character:FindFirstChild(name)
                    if p and p:IsA("BasePart") then
                        p.CanCollide = false
                    end
                end
            end)
        
            -- 4. GIỮ NHÂN VẬT TRÊN KHÔNG AN TOÀN (BodyVelocity chống rung giật và triệt tiêu trọng lực)
            local bv = RootPart:FindFirstChild("BocchiBV") or RootPart:FindFirstChild("eltrul")
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "BocchiBV"
                bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                bv.Velocity = Vector3.zero
                bv.Parent = RootPart
            else
                bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                bv.Velocity = Vector3.zero
            end

            pcall(function()
                RootPart.AssemblyLinearVelocity = Vector3.zero
                RootPart.AssemblyAngularVelocity = Vector3.zero
            end)

            -- 5. LOGIC DI CHUYỂN ĐẶC BIỆT (Sea 3 Submarine)
            if SeaIndex == 3 and TargetCFrame.Position.Y < -1500 then
                local SubmarinePos = CFrame.new(-16269, 23, 1371)
                if (RootPart.Position - SubmarinePos.Position).Magnitude > 60 then
                    TweenController.Create(SubmarinePos)
                    return
                end
                pcall(function()
                    local netModule = game.ReplicatedStorage:FindFirstChild("Modules") and game.ReplicatedStorage.Modules:FindFirstChild("Net")
                    if netModule and netModule:IsA("ModuleScript") then
                        local reqNet = require(netModule)
                        if reqNet and reqNet.RemoteFunction then
                            reqNet:RemoteFunction("SubmarineWorkerSpeak"):InvokeServer("TravelToSubmergedIsland")
                        end
                    end
                end)
                return
            end

            -- 6. THỰC THI TWEEN
            if TweenInstance then
                pcall(function() TweenInstance:Cancel() end)
            end

            local Speed = (CurrentDist < 30) and 50 or 175
            local Time = CurrentDist / Speed

            local tweenService = game:GetService("TweenService")
            TweenInstance = tweenService:Create(
                RootPart,
                TweenInfo.new(Time, Enum.EasingStyle.Linear),
                {CFrame = TargetCFrame}
            )
            local MyTween = TweenInstance

            -- [M5] LOI: Cancel tween CU kich Completed cua no chay SAU khi tween MOI da duoc
            -- tao, handler cu nay xoa _CurrentTarget (lam chet check chong trung ten o tren)
            -- VA dat AssemblyLinearVelocity = 0 trong luc tween moi dang chay -> giay.
            -- Chi duoc ket thuc/dung han khi no VAN la tween hien tai.
            MyTween.Completed:Connect(function(playbackState)
                if TweenInstance ~= MyTween then
                    return
                end
                if playbackState == Enum.PlaybackState.Cancelled then
                    return
                end
                TweenController._CurrentTarget = nil
                if bv and bv.Parent then
                    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                    bv.Velocity = Vector3.zero
                end
                pcall(function()
                    RootPart.AssemblyLinearVelocity = Vector3.zero
                    RootPart.AssemblyAngularVelocity = Vector3.zero
                end)
            end)

            TweenInstance:Play()
        end



