        -- (TRUOC LevelFarm 17) -> khi Refresh lan ra true, MOI TICK no keo nhan vat bay toi
        -- Thac Nuoc Sea 3 (5251, 37, 453) = dung hinh "co roi ma cu bay toi do".
        -- ScriptStorage.Tools (metatable 968) live-quet Character + Backpack theo Ten nen
        -- M12DaCoTool dung cach quet do, long them GetAttribute("OriginalName") vi nhieu tool
        -- bi doi ten khi equip.  Ket qua DUOC DINH: da co thi khong bao gio di lay nua.
        M12DaCo = {}
        M12ScanDen = 0
        M12YamaDen = 0
        M12YamaDaLog = false
        M12YamaChoDen = 0
        function M12DaCoTool(ten)
            if M12DaCo[ten] then
                return true
            end
            if os.clock() < M12ScanDen then
                return false
            end
            M12ScanDen = os.clock() + 5
            local co = false
            pcall(function()
                if ScriptStorage.Backpack and ScriptStorage.Backpack[ten] then
                    co = true
                    return
                end
                local lp = game:GetService("Players").LocalPlayer
                local list = {}
                if lp.Character then
                    for _, t in ipairs(lp.Character:GetChildren()) do
                        table.insert(list, t)
                    end
                end
                local bag = lp:FindFirstChild("Backpack")
                if bag then
                    for _, t in ipairs(bag:GetChildren()) do
                        table.insert(list, t)
                    end
                end
                for _, t in ipairs(list) do
                    if t:IsA("Tool") and (t.Name == ten or t:GetAttribute("OriginalName") == ten) then
                        co = true
                        return
                    end
                end
            end)
            if co then
                M12DaCo[ten] = true
            end
            return co
        end

