        -- tim de quy, va ten model co the them dau cach/ky tu -> so sanh dang da hoa.
        function MobNormName(s)
            return (string.gsub(string.lower(tostring(s or "")), "[^%a0-9]", ""))
        end

        -- [km41] "kiem tra 1 lan thoi": dem quai chi QUET workspace.Enemies 1 LAN moi 0.5s va
        -- luu vao map ten->solan. Truoc day moi lan goi (questStateLine + doi muc tieu +
        -- PickLiveSeaMob vet nhiem vu) la quet lai toan bo -> scheduler ~20 tick/s nen
        -- quet den ~40 lan/giay.
        -- [km45] 0.5s -> 2s: quet lien tuc bi coi la dau hieu bot.
        function LiveEnemyCounts(ttl)
            local now = os.clock()
            if EnemyCountCache and EnemyCountCacheTick and (now - EnemyCountCacheTick < (tonumber(ttl) or tonumber(Config and Config.Settings and Config.Settings.EnemyCountMemo) or 2)) then
                return EnemyCountCache
            end
            EnemyCountCacheTick = now
            local map = {}
            pcall(function()
                local ef = workspace:FindFirstChild("Enemies")
                if not ef then return end
                for _, e in ipairs(ef:GetChildren()) do
                    local h = e:FindFirstChildWhichIsA("Humanoid", true)
                    if h and h.Health > 0 then
                        local nm = MobNormName(e.Name)
                        map[nm] = (map[nm] or 0) + 1
                    end
                end
            end)
            EnemyCountCache = map
            return map
        end

        function MobLiveCount(mobName)
            if not mobName or mobName == "" then return 0 end
            local want = MobNormName(mobName)
            if want == "" then return 0 end
            local map = LiveEnemyCounts()
            local n = map[want] or 0
            for nm, c in pairs(map) do
                if nm ~= want and string.find(nm, want, 1, true) then
                    n = n + c
                end
            end
            return n
        end

        -- [km30] Chon loai quai DANG CO TRONG SERVER o sea hien tai (uu tien task gan cap nhat),
        -- de LevelFarm khong bay den toa do cu cua loai quai da khong con spawn -> dung im giua troi.
        function PickLiveSeaMob()
            local best, bestReq, bestCount = nil, -1, 0
            pcall(function()
                local seaQuestIds = (SeaIndex == 1 and Sea1Quests) or (SeaIndex == 2 and Sea2Quests) or Sea3Quests
                local pLevel = (ScriptStorage.PlayerData and ScriptStorage.PlayerData.Level) or 1
                for _, qId in ipairs(seaQuestIds or {}) do
                    for _, qData in ipairs((BuiltInQuests and BuiltInQuests[qId]) or {}) do
                        local req = qData.LevelReq
                        if req and req <= pLevel then
                            for mobName in pairs(qData.Task or {}) do
                                local c = MobLiveCount(mobName)
                                if c > 0 and (req > bestReq or (req == bestReq and c > bestCount)) then
                                    best, bestReq, bestCount = mobName, req, c
                                end
                            end
                        end
                    end
                end
            end)
            return best, bestCount
        end

