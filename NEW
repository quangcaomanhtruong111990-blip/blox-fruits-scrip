        local function IsMobMatch(instName, targetName)
            if not instName or not targetName then return false end
            instName = tostring(instName)
            targetName = tostring(targetName)
            if instName == targetName then return true end

            -- Strip [Lv. 123] suffix
            local cleanInst = instName:gsub("%s*%[Lv%.%s*%d+%]%s*", ""):gsub("^%s*(.-)%s*$", "%1")
            local cleanTarget = targetName:gsub("%s*%[Lv%.%s*%d+%]%s*", ""):gsub("^%s*(.-)%s*$", "%1")
            if cleanInst == cleanTarget then return true end

            if VietnameseToEnglishMob[cleanInst] then cleanInst = VietnameseToEnglishMob[cleanInst] end
            if VietnameseToEnglishMob[cleanTarget] then cleanTarget = VietnameseToEnglishMob[cleanTarget] end
            if cleanInst == cleanTarget then return true end

            local s1 = string.lower(cleanInst)
            local s2 = string.lower(cleanTarget)
            if s1 == s2 then return true end
            if string.find(s1, s2, 1, true) or string.find(s2, s1, 1, true) then return true end

            local s1_no_s = (s1:sub(-1) == "s") and s1:sub(1, -2) or s1
            local s2_no_s = (s2:sub(-1) == "s") and s2:sub(1, -2) or s2
            if s1_no_s == s2_no_s or string.find(s1_no_s, s2_no_s, 1, true) or string.find(s2_no_s, s1_no_s, 1, true) then
                return true
            end

            -- Common mob name variants / typo mappings
            if (string.find(s1, "bandit") and string.find(s2, "bandit")) or
               (string.find(s1, "cuop") and string.find(s2, "bandit")) or
               (string.find(s1, "monkey") and string.find(s2, "monkey")) or
               (string.find(s1, "gorilla") and string.find(s2, "gorilla")) or
               (string.find(s1, "mummy") and string.find(s2, "mummy")) or
               (string.find(s1, "demonic") and string.find(s2, "demonic")) or
               (string.find(s1, "zombie") and string.find(s2, "zombie")) or
               (string.find(s1, "skeleton") and string.find(s2, "skeleton")) or
               (string.find(s1, "vampire") and string.find(s2, "vampire")) or
               (string.find(s1, "swordsman") and string.find(s2, "swordsman")) or
               (string.find(s1, "islander") and string.find(s2, "islander")) or
               (string.find(s1, "soldier") and string.find(s2, "soldier")) or
               (string.find(s1, "pirate") and string.find(s2, "pirate")) or
               (string.find(s1, "captain") and string.find(s2, "captain")) or
               (string.find(s1, "admiral") and string.find(s2, "admiral")) then
                return true
            end
            return false
        end

        function GetMobPosition(mobName)
            if not mobName or mobName == "" then return nil end
            if type(mobName) == "table" then
                mobName = mobName[1]
            end
            local strName = tostring(mobName)

            -- 1. Check ScriptStorage.MobRegions
            local reg = ScriptStorage.MobRegions and ScriptStorage.MobRegions[strName]
            if reg and #reg > 0 then
                local rawPos = reg[1]
                local pos = (typeof(rawPos) == "CFrame" and rawPos.Position) or (typeof(rawPos) == "Vector3" and rawPos) or nil
                if pos then return pos end
            end

            -- 2. Direct lookup in MobPositionsFallback
            if MobPositionsFallback and MobPositionsFallback[strName] then
                local rawPos = MobPositionsFallback[strName]
                local pos = (typeof(rawPos) == "CFrame" and rawPos.Position) or (typeof(rawPos) == "Vector3" and rawPos) or nil
                if pos then return pos end
            end

            -- 3. Fuzzy search in MobPositionsFallback
            if MobPositionsFallback then
                for fbName, fbPos in pairs(MobPositionsFallback) do
                    if IsMobMatch(fbName, strName) then
                        local rawPos = fbPos
                        local pos = (typeof(rawPos) == "CFrame" and rawPos.Position) or (typeof(rawPos) == "Vector3" and rawPos) or nil
                        if pos then return pos end
                    end
                end
            end

            -- 4. Check workspace.Enemies
            local enemies = workspace:FindFirstChild("Enemies")
            if enemies then
                for _, enemy in ipairs(enemies:GetChildren()) do
                    if enemy:IsA("Model") and IsMobMatch(enemy.Name, strName) then
                        local hrp = enemy:FindFirstChild("HumanoidRootPart") or enemy.PrimaryPart
                        if hrp then return hrp.Position end
                    end
                end
            end

            -- 5. Fallback scan in workspace for spawn parts
            local foundPos = nil
            pcall(function()
                for _, spawnObj in pairs(workspace:GetDescendants()) do
                    if spawnObj:IsA("BasePart") and (IsMobMatch(spawnObj.Name, strName) or string.find(string.lower(spawnObj.Name), string.lower(strName))) then
                        foundPos = spawnObj.Position
                        break
                    end
                end
            end)

            return foundPos
        end

        function CombatController.Grab(MobName, TargetCFrame)
            if not CombatController.GRAB then return end
            pcall(function()
                if typeof(sethiddenproperty) == "function" then
                    sethiddenproperty(game.Players.LocalPlayer, "SimulationRadius", math.huge)
                end
            end)

            local lp = game:GetService("Players").LocalPlayer
            local myChar = lp and lp.Character
            local myHrp = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar.PrimaryPart)
            if not myHrp then return end

            local enemies = workspace:FindFirstChild("Enemies")
            if not enemies then return end

            local function isMatchingMob(name)
                if not MobName or MobName == "" then return true end
                if type(MobName) == "table" then
                    for _, targetName in ipairs(MobName) do
                        if IsMobMatch(name, targetName) then
                            return true
                        end
                    end
                    return false
                elseif type(MobName) == "string" then
                    return IsMobMatch(name, MobName)
                end
                return false
            end

            local MobsTable = {}
            for _, Mon in ipairs(enemies:GetChildren()) do
                if Mon:IsA("Model") and isMatchingMob(Mon.Name) then
                    local hum = Mon:FindFirstChildOfClass("Humanoid")
                    local hrp = Mon:FindFirstChild("HumanoidRootPart") or Mon.PrimaryPart
                    if hum and hum.Health > 0 and hrp then
                        local dist = (hrp.Position - myHrp.Position).Magnitude
                        if dist <= (CombatController.GRAB_DISTANCE or 450) then
                            table.insert(MobsTable, Mon)
                        end
                    end
                end
            end

            if #MobsTable == 0 then return end

            -- Xác định tọa độ mặt đất của quái mục tiêu (giữ quái ở mặt đất, KHÔNG kéo lên không trung)
            local CenterPoint = nil
            if TargetCFrame then
                if typeof(TargetCFrame) == "Instance" then
                    local hrp = TargetCFrame:FindFirstChild("HumanoidRootPart") or TargetCFrame.PrimaryPart
                    CenterPoint = hrp and hrp.Position
                elseif typeof(TargetCFrame) == "CFrame" then
                    CenterPoint = TargetCFrame.Position
                elseif typeof(TargetCFrame) == "Vector3" then
                    CenterPoint = TargetCFrame
                end
            end

            if not CenterPoint and MobsTable[1] then
                local firstHrp = MobsTable[1]:FindFirstChild("HumanoidRootPart") or MobsTable[1].PrimaryPart
                CenterPoint = firstHrp and firstHrp.Position
            end

            if not CenterPoint then return end

            -- Gom quái tại mặt đất (giữ nguyên độ cao Y của bãi quái, không nhấc lên trời)
            for _, Mon in ipairs(MobsTable) do
                pcall(function()
                    local hrp = Mon:FindFirstChild("HumanoidRootPart") or Mon.PrimaryPart
                    local hum = Mon:FindFirstChildOfClass("Humanoid")
                    if hrp and hum and hum.Health > 0 then
                        hrp.CanCollide = false
                        for _, p in ipairs(Mon:GetDescendants()) do
                            if p:IsA("BasePart") then
                                p.CanCollide = false
                            end
                        end

                        local bv = hrp:FindFirstChild("FarmingVelocity")
                        if not bv then
                            bv = Instance.new("BodyVelocity")
                            bv.Name = "FarmingVelocity"
                            bv.MaxForce = Vector3.new(100000, 100000, 100000)
                            bv.Parent = hrp
                        end
                        bv.Velocity = Vector3.zero

                        local bp = hrp:FindFirstChild("FarmingPosition")
                        if not bp then
                            bp = Instance.new("BodyPosition")
                            bp.Name = "FarmingPosition"
                            bp.MaxForce = Vector3.new(100000, 100000, 100000)
                            bp.P = 10000
                            bp.D = 100
                            bp.Parent = hrp
                        end
                        bp.Position = CenterPoint
                        hrp.CFrame = CFrame.new(CenterPoint)
                    end
                end)
            end
        end


