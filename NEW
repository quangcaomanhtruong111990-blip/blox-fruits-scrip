                                                break
                                            end
                                        end
                                    end
                                end
                            end

                            -- Nếu đã đến gần quái hoặc đã bay quá 15s thì kích hoạt trạng thái đã đến bãi quái
                            if isNear or (os.time() - farmMobStart >= 15) then
