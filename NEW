        function ThieuNguyenLieuSea(sea)
            local ok, res = pcall(function()
                if type(GodhumanMaterialsList) ~= "table" then return nil end
                local ds = {}
                for _, mat in ipairs(GodhumanMaterialsList) do
                    if (tonumber(mat.Sea) or 0) == sea then
                        local cnt = tonumber(GetItemCount(mat.Name)) or 0
                        local daNop = (type(AncientMonkMaterialsSubmitted) == "table")
                            and AncientMonkMaterialsSubmitted[mat.Name]
                        if cnt < (tonumber(mat.Req) or 1) and not daNop then
                            table.insert(ds, {
                                Name = mat.Name, Count = cnt, Req = mat.Req,
                                Mobs = mat.Mobs, Sea = mat.Sea
                            })
                        end
                    end
                end
                if #ds == 0 then return nil end
                return ds
            end)
            return (ok and res) or nil
        end

        -- SeaTravelTick goi moi frame -> cache 20s (GetItemCount tu no da co throttle remote).
        function ThieuNguyenLieuSeaCached(sea)
            local now = os.clock()
            Dt2MatCache = Dt2MatCache or {}
            local c = Dt2MatCache[sea]
            if c and (now - c.t) < 20 then
                return c.v
            end
            local v = ThieuNguyenLieuSea(sea)
            Dt2MatCache[sea] = { t = now, v = v }
            return v
        end

