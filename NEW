                            if not isPlayer then
                                local cf = MeleeCFrameOf(d)
                                if cf then
                                    models = models + 1
                                    -- [km35] danh theo MOI ten ma NPC dang mang
                                    for _, label in ipairs(MeleeNpcLabels(d)) do
                                        local key = MeleeNormName(label)
                                        if key ~= "" and not idx[key] then
                                            idx[key] = { cf = cf, name = label }
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end)
            MeleeNpcIndex = idx
            print("[MeleeCheck] da quet map: " .. tostring(models) .. " model co Humanoid, " ..
                tostring(table.size(idx)) .. " ten NPC trong server")
            return idx
        end
        -- Ten can tim cho 1 loai vo: ten NPC cu + ten bien the + chinh ten mon vo
        function MeleeNpcTerms(styleName)
            local out, seen = {}, {}
            local info = MeleeNpcInfo and MeleeNpcInfo[styleName]
            local function add(n)
                if n and not seen[MeleeNormName(n)] then
                    seen[MeleeNormName(n)] = true
                    table.insert(out, n)
                end
            end
            if info then
                add(info.Npc)
                if type(info.Aliases) == "table" then
                    for _, a in ipairs(info.Aliases) do add(a) end
                end
            end
            add(styleName)
            return out
        end
        -- Tim model NPC THAT trong server hien tai (ten dung truoc, gan giong sau)
        function FindMeleeNpcCFrame(npcName, styleName)
            local terms = {}
            if npcName then table.insert(terms, npcName) end
            if styleName then
                for _, t in ipairs(MeleeNpcTerms(styleName)) do
                    local dup = false
                    for _, have in ipairs(terms) do
                        if MeleeNormName(have) == MeleeNormName(t) then dup = true break end
                    end
                    if not dup then table.insert(terms, t) end
                end
            end
            if #terms == 0 then return nil end
            local ok, res = pcall(function()
                local folders = {
                    workspace:FindFirstChild("NPCs"),
                    game:GetService("ReplicatedStorage"):FindFirstChild("NPCs"),
                }
                -- [km34] lay 1 lan toan bo Model trong folder NPC (NPC co the nam sau folder con)
                -- [km35] so sanh theo TEN HIEN THI (label), khong chi ten Model
                local pool = {}
                for _, f in ipairs(folders) do
                    if f then
                        for _, obj in ipairs(f:GetDescendants()) do
                            if obj:IsA("Model") then
                                table.insert(pool, { obj = obj, labels = MeleeNpcLabels(obj) })
                            end
                        end
                    end
                end
                local function poolFind(want, exactOnly)
                    local wk = MeleeNormName(want)
                    for _, ent in ipairs(pool) do
                        for _, label in ipairs(ent.labels) do
                            local lk = MeleeNormName(label)
                            if lk == wk or (not exactOnly and lk ~= "" and #wk > 2 and
                                (string.find(lk, wk, 1, true) or string.find(wk, lk, 1, true))) then
                                local cf = MeleeCFrameOf(ent.obj)
                                if cf then return cf end
                            end
                        end
                    end
                    return nil
                end
                for _, want in ipairs(terms) do
                    for _, f in ipairs(folders) do
                        if f then
                            local exact = f:FindFirstChild(want)
                            if exact then
                                local cf = MeleeCFrameOf(exact)
                                if cf then return cf end
                            end
                        end
                    end
                    local hit = poolFind(want, true)
                    if hit then return hit end
                    local stored = ScriptStorage and ScriptStorage.NPCs and ScriptStorage.NPCs[want]
                    if stored then
                        if typeof(stored) == "CFrame" then return stored end
                        local cf = MeleeCFrameOf(stored)
                        if cf then return cf end
                    end
                end
                for _, want in ipairs(terms) do
                    local hit = poolFind(want, false)
                    if hit then return hit end
                    for _, obj in ipairs(pool) do
                        if MeleeNameMatches(obj.obj.Name, want) then
                            local cf = MeleeCFrameOf(obj.obj)
                            if cf then return cf end
                        end
                    end
                end
                -- [km25] Van de: quet toan map (Sabi khong nam trong workspace.NPCs)
                -- Luu y: index toan map co ca QUAI ( cung co Humanoid), nen khong duoc
                -- khop long theo ten mon vo o day, chi duoc khop gan chinh xac.
                local styleKey = styleName and MeleeNormName(styleName) or ""
                local idx = MeleeBuildNpcIndex()
                for _, want in ipairs(terms) do
                    local key = MeleeNormName(want)
                    if idx[key] then return idx[key].cf end
                end
                for _, want in ipairs(terms) do
                    if MeleeNormName(want) ~= styleKey then
                        for key, ent in pairs(idx) do
                            if MeleeNameMatches(ent.name, want) then return ent.cf end
                        end
                    end
                    -- Cuoi cung: NPC mang TEN MON VO (vd "Dragon Claw Master" o Sea 3)
                    local nk = MeleeNormName(want)
                    if #nk >= 6 then
                        for _, ent in pairs(idx) do
                            if string.find(MeleeNormName(ent.name), nk, 1, true) then return ent.cf end
                        end
                    end
                end
                return nil
            end)
            return ok and res or nil
        end
        function ListNpcNames()
            local ok, res = pcall(function()
                local out, seen = {}, {}
                local function add(n)
                    if n and not seen[n] and #out < 200 then
                        seen[n] = true
                        table.insert(out, n)
                    end
                end
                -- [km35] chi lay NPC trong folder NPCs (kem ten hien thi) -> danh sach khong bi
                -- lan loi ten quai cua index toan map
                for _, f in ipairs({ workspace:FindFirstChild("NPCs"), game:GetService("ReplicatedStorage"):FindFirstChild("NPCs") }) do
                    if f then
                        for _, obj in ipairs(f:GetDescendants()) do
                            if obj:IsA("Model") then
                                for _, label in ipairs(MeleeNpcLabels(obj)) do add(label) end
                            end
                        end
                    end
                end
                if #out == 0 then
                    for _, ent in pairs(MeleeBuildNpcIndex()) do add(ent.name) end
                end
                return table.concat(out, ", ")
            end)
            return (ok and res) or "loi doc danh sach NPC"
        end
        -- [km35] Tim ten NPC GIONG GIONG ten can tim (cung 4 ky tu dau) -> de sua MeleeNpcInfo
        function MeleeNpcSimilar(want)
            local ok, res = pcall(function()
                local wk = MeleeNormName(want)
                if #wk < 3 then return "(ten qua ngan)" end
                local pre = string.sub(wk, 1, 4)
                local out, seen = {}, {}
                local function add(n)
                    if n and not seen[n] and #out < 8 then
                        seen[n] = true
                        table.insert(out, n)
                    end
                end
                for _, ent in pairs(MeleeBuildNpcIndex()) do
                    local k = MeleeNormName(ent.name)
                    if string.sub(k, 1, #pre) == pre or string.find(k, wk, 1, true) then
                        add(ent.name)
                    end
                end
                if #out == 0 then return "(khong co ten nao bat dau bang '" .. pre .. "')" end
                return table.concat(out, " | ")
            end)
            return (ok and res) or "loi"
        end
        -- Co NPC cua vo nay trong server hien tai khong? (cache 20s vi Quet tim kha nang)
        function MeleeNpcHere(name)
            local info = MeleeNpcInfo[name]
            if not info then return nil end
            MeleeNpcCache = MeleeNpcCache or {}
            MeleeNpcCacheTick = MeleeNpcCacheTick or {}
            local now = os.time()
            local cached = MeleeNpcCache[name]
            if cached ~= nil and (now - (MeleeNpcCacheTick[name] or 0)) < 20 then
                return cached or nil
            end
            local cf = FindMeleeNpcCFrame(info.Npc, name)
            if not cf and (now - (MeleeIndexForceTick or 0)) >= 60 then
                -- [km34] ep quet lai toan map 1 lan (index cu co the thieu NPC vua stream)
                MeleeIndexForceTick = now
                MeleeNpcIndex = nil
                cf = FindMeleeNpcCFrame(info.Npc, name)
            end
            MeleeNpcCache[name] = cf or false
            MeleeNpcCacheTick[name] = now
            return cf
        end
        -- [km35] NPC chua stream (con o xa) van du tinh la lay duoc NEU co NPC ke ben de bay toi
        function MeleeNpcReachable(name)
            if MeleeNpcHere(name) then return true end
            local info = MeleeNpcInfo[name]
            if info and info.Near and MeleeNpcHere(info.Near) then return true end
            return false
        end
        function MeleeRefreshNpcCache()
            MeleeNpcCache = {}
            MeleeNpcCacheTick = {}
            MeleeNpcIndex = nil
            MeleeNpcIndexSea = nil
        end

        function MeleeCurAmount(currency)
            local pData = ScriptStorage and ScriptStorage.PlayerData
            local v = pData and tonumber(pData[currency])
            if v then return v end
            local okD, dp = pcall(function()
                local d = game:GetService("Players").LocalPlayer:FindFirstChild("Data")
                local inst = d and d:FindFirstChild(currency)
                return inst and tonumber(inst.Value) or 0
            end)
            return (okD and dp) or 0
        end

        -- Tra nil = DU TIEN. Ngugc lai: "Beli 120000/3000000"
        function MeleePriceMissing(name)
            local md = MeleePrices and MeleePrices[name]
            if not md or not md.Price then return nil end
            local miss = {}
            for cur, need in pairs(md.Price) do
                local have = MeleeCurAmount(cur)
                local needNum = tonumber(need) or 0
                if have < needNum then
                    table.insert(miss, cur .. " " .. have .. "/" .. needNum)
                end
            end
            if #miss == 0 then return nil end
            return table.concat(miss, " + ")
        end

        -- Tra nil = DU VO DIEU KIEN. Ngugc lai: "can Black Leg mastery 50/300 + ..."
        function MeleePrereqMissing(name)
            local pr = MeleePrereq[name]
            if not pr then return nil end
            local ok, res = pcall(function()
                local miss = {}
                for _, need in ipairs(pr) do
                    local m = GetPlayerMeleeMastery(need.melee)
                    if not GetPlayerMeleeTool(need.melee) and m <= 0 then
                        table.insert(miss, "chua co vo " .. need.melee)
                    elseif m < need.mastery then
                        table.insert(miss, "can " .. need.melee .. " mastery " .. m .. "/" .. need.mastery)
                    end
                end
                if #miss == 0 then return nil end
                return table.concat(miss, " + ")
            end)
            return ok and res or nil
        end

        -- [km23] Vo vua bi NPC tu (check tan noi != 1) -> tam bo qua
        function MeleeIsDenied(name)
            local t = MeleeDenied and MeleeDenied[name]
            return (t ~= nil) and (os.time() - t) < MeleeDenySeconds
        end
        function MeleeDeny(name, why, so)
            MeleeDenied = MeleeDenied or {}
            -- [km56] so = so giay bo qua (mac dinh 10 phut). Luu thoi diem "gia" de
            -- MeleeIsDenied tu het hieu dung sau so giay do.
            local secs = tonumber(so) or MeleeDenySeconds
            MeleeDenied[name] = os.time() - (MeleeDenySeconds - secs)
            print("[MeleeCheck] TAM BO QUA " .. tostring(name) .. " trong " .. secs .. "s: " .. tostring(why))
        end

        function MeleeIsOwned(name)
            local ok, res = pcall(function()
                if GetPlayerMeleeTool(name) then return true end
                local m = ScriptStorage and ScriptStorage.Melees and ScriptStorage.Melees[name]
                if m and tonumber(m) and tonumber(m) > 0 then return true end
                -- [km52] HUD game ghi "Ten Vo: 400" => da mua that, du da cat vo vao kho
                local hv = tonumber(ReadMeleeMasteryHud()[ToCanonicalMeleeName(name) or name])
                if hv and hv > 0 then return true end
                return false
            end)
            return (ok and res) == true
        end

        -- Danh gia toan bo chuoi vo theo thu tu. Tra:
        --   ev.pick  = vo CO THE LAM NGAY BAY GIO (buy / farm mastery)
        --   ev.first = vo dau tien trong chuoi CON THIEU (de bao ly do)
        function EvalMeleeTarget()
            local first, pickBuy, pickFarm = nil, nil, nil
            local all = {}
            for _, name in ipairs(MeleeChain) do
                local md = MeleePrices and MeleePrices[name]
                local req = (md and md.NextLevelRequirement) or 400
                local mastery = 0
                pcall(function() mastery = GetPlayerMeleeMastery(name) end)
                if mastery >= req then
                    table.insert(all, name .. "=XONG(" .. mastery .. ")")
                else
                    local info = MeleeNpcInfo[name]
                    local sea = (info and info.Sea) or 0
                    local owned = MeleeIsOwned(name)
                    local entry = {
                        name = name, sea = sea, npc = info and info.Npc or "?",
                        mastery = mastery, req = req, owned = owned,
                    }
                    if owned then
                        entry.action = "farm"
                        entry.reason = "dang co, cay mastery " .. mastery .. "/" .. req
                    elseif not MeleeNpcReachable(name) then
                        -- [km24] Quyet dinh bang NPC THAT trong server, khong bang toa do Sea cu
                        entry.action = "npc_absent"
                        entry.reason = "khong tim thay NPC [" .. entry.npc .. "] trong server (dang o Sea " ..
                            tostring(SeaIndex) .. ")"
                        -- [km34] In ten NPC that trong server de sua MeleeNpcInfo cho dung ban nay
                        MeleeNpcDumpTick = MeleeNpcDumpTick or {}
                        if not MeleeNpcDumpTick[name] or os.time() - MeleeNpcDumpTick[name] > 90 then
                            MeleeNpcDumpTick[name] = os.time()
                            print("[MeleeCheck] " .. name .. " khong tim thay NPC [" .. entry.npc ..
                                "] (tim theo: " .. table.concat(MeleeNpcTerms(name), " | ") ..
                                "] | TEN GAN GIONG: " .. MeleeNpcSimilar(entry.npc) ..
                                " -> NPC dang co trong server: " .. ListNpcNames())
                        end
                    else
                        local priceMiss = MeleePriceMissing(name)
                        local preqMiss = MeleePrereqMissing(name)
                        entry.priceMiss, entry.preqMiss = priceMiss, preqMiss
                        if preqMiss then
                            entry.action = "farm_prereq"
                            entry.reason = preqMiss
                        elseif priceMiss then
                            entry.action = string.find(priceMiss, "Fragments", 1, true) and "farm_fragments" or "farm_beli"
                            entry.reason = "thieu " .. priceMiss
                        elseif MeleeIsDenied(name) then
                            -- [km23] Da den NPC ma server van tu -> nghi 10 phut, khong bay lai nua
                            entry.action = "denied"
                            entry.reason = "den " .. entry.npc .. " roi bi tu, con nghi " ..
                                (MeleeDenySeconds - (os.time() - MeleeDenied[name])) .. "s"
                        else
                            entry.action = "buy"
                            entry.reason = "du dieu kien -> den " .. entry.npc .. " check tan noi"
                        end
                    end
                    table.insert(all, name .. "=" .. (owned and "CO" or "KO") .. " " .. mastery .. "/" .. req
                        .. " [" .. entry.action .. (entry.action == "npc_absent" and ("|" .. entry.npc) or "") .. "]")
                    if not first then first = entry end
                    if entry.action == "buy" and not pickBuy then pickBuy = entry end
                    if entry.action == "farm" and not pickFarm then pickFarm = entry end
                end
            end
            -- [km51] In toan bo 10 vo 1 phut/lan de hai nguoi cung thay no nghi gi
            MeleeCheckDumpTick = MeleeCheckDumpTick or 0
            if os.clock() - MeleeCheckDumpTick > 60 then
                MeleeCheckDumpTick = os.clock()
                print("[Vo check] " .. table.concat(all, " | "))
            end
            if not first then return nil end
            return { pick = pickBuy or pickFarm, first = first, all = all }
        end

        -- [FC5] Mac vo dang can cay mastery (1 lan / 60s hoac khi doi vo khac).
        -- Chi lam viec khi co Tool THAT trong Character/Backpack; vo da cat vao kho (chi
        -- thay tren [Vo HUD]) thi khong the mac -> tra false, LevelFarm van fam binh thuong.
        function EquipMeleeForMastery(meleeName)
            if not meleeName then return false end
            local ok, done = pcall(function()
                local tool = GetPlayerMeleeTool(meleeName)
                if not tool then return false end
                local char = game.Players.LocalPlayer and game.Players.LocalPlayer.Character
                local held = char and char:FindFirstChildOfClass("Tool")
                if held and held.Name == tool.Name then return true end
                local LPC = FunctionsHandler.LocalPlayerController
                if LPC and LPC.Methods and LPC.Methods.EquipTool then
                    LPC.Methods.EquipTool:Call(tool.Name)
                    LPC.Methods.EquipTool:Call("Melee")
                end
                print("[FC5] Mac vo " .. tostring(meleeName) .. " (tool '" .. tostring(tool.Name) ..
                    "') de cay mastery -> LevelFarm fam truc tiep")
                return true
            end)
            return (ok and done) or false
        end

        FunctionsHandler.MeleesController:RegisterMethod(
            "Refresh",
            function()
                if not Config.Items.AutoFullyMelees then
                    return false
                end

                local isSaberOngoing = (type(IsSaberQuestActive) == "function" and IsSaberQuestActive()) or (CurrentTask == "Saber")
                if isSaberOngoing then
                    return false
                end

                -- [km22] Danh gia theo chuoi vo, cache 1s de khong doc mastery moi tick
                if not MeleeEvalTick or os.time() - MeleeEvalTick >= 1 then
                    MeleeEvalTick = os.time()
                    MeleeEvalCache = EvalMeleeTarget()
                end
                local ev = MeleeEvalCache
                -- [km23] KHONG co vo nao lay duoc ngay bay gio (sai Sea / thieu diem F /
                -- thieu vo dieu kien / vua bi NPC tu) -> tra false de Raid (diem F)
                -- hoac LevelFarm duoc chay, thay vi Melee giot tick roi dung cho.
                if not ev or not ev.pick then
                    ScriptStorage.IsGettingMelee = false
                    return false
                end

                -- [FC5] pick.action == "farm" = DA CO vo do, chi con thieu mastery -> Melee
                -- KHONG can giu tick nua: mac dung vo (1 lan/60s) roi tra false de LevelFarm
                -- fam truc tiep. Truoc day Melee giu tick rồi Start goi LevelFarm ho -> them
                -- 1 chan trung gian, va chinh chan do sinh ra loi dung yen o NPC (build FC3).
                -- Melee chi con giu tick khi co vo MUA DUOC NGAY ("buy") -> can bay toi NPC.
                if ev.pick.action == "farm" then
                    local need = ev.pick.name
                    local memo = Fc5EquipMemo
                    if not memo or memo.style ~= need or (os.time() - (memo.at or 0)) > 60 then
                        Fc5EquipMemo = { style = need, at = os.time() }
                        EquipMeleeForMastery(need)
                    end
                    ScriptStorage.IsGettingMelee = false
                    return false
                end
                return true
            end
        )

        FunctionsHandler.MeleesController:RegisterMethod(
            "Start",
            function()
                ScriptStorage.IsGettingMelee = false

                if not Config.Items.AutoFullyMelees then
                    return
                end

                -- [ƯU TIÊN TUYỆT ĐỐI CHO SABER]
                -- Nếu đang làm nhiệm vụ Saber hoặc đến cấp làm Saber (>= 200 tại Sea 1 mà chưa có Saber)
                -- TẠM DỪNG HOÀN TOÀN việc đổi/mua/cày võ để người chơi làm xong nhiệm vụ Saber!
                local isSaberOngoing = (type(IsSaberQuestActive) == "function" and IsSaberQuestActive()) or (CurrentTask == "Saber")
                if isSaberOngoing then
                    ScriptStorage.IsGettingMelee = false
                    return
                end

                -- 1. Kiểm tra võ đang cầm hiện tại
                local curMelee, curMastery, reqMastery = GetCurrentMeleeMastery()
                
                -- Nếu đang cầm một võ và võ đó CHƯA ĐẠT Mastery yêu cầu (thường là 400)
                -- TIẾP TỤC DÙNG VÕ NÀY để cày, KHÔNG nhảy lung tung sang võ khác!
                if curMelee then
                    LastLockedMelee = curMelee
                    if curMastery < reqMastery then
                        SetTask("MainTask", "Checking & Farming Melee Mastery")
                        SetTask("SubTask", "Farming Mastery: " .. tostring(curMelee) .. " (" .. curMastery .. "/" .. reqMastery .. ")")
                        if FunctionsHandler.LevelFarm and FunctionsHandler.LevelFarm.Methods and FunctionsHandler.LevelFarm.Methods.Start then
                            pcall(function() FunctionsHandler.LevelFarm.Methods.Start:Call() end)
                        end
                        return
                    end
                elseif LastLockedMelee then
                    local lastTool = GetPlayerMeleeTool(LastLockedMelee)
                    if lastTool then
                        local lastMastery = GetPlayerMeleeMastery(LastLockedMelee)
                        local req = (MeleePrices and MeleePrices[LastLockedMelee] and MeleePrices[LastLockedMelee].NextLevelRequirement) or 400
                        if lastMastery < req then
                            if FunctionsHandler.LocalPlayerController and FunctionsHandler.LocalPlayerController.Methods and FunctionsHandler.LocalPlayerController.Methods.EquipTool then
                                pcall(function()
                                    FunctionsHandler.LocalPlayerController.Methods.EquipTool:Call(lastTool.Name)
                                    FunctionsHandler.LocalPlayerController.Methods.EquipTool:Call("Melee")
                                end)
                            end
                            SetTask("MainTask", "Checking & Farming Melee Mastery")
                            SetTask("SubTask", "Farming Mastery: " .. tostring(LastLockedMelee) .. " (" .. lastMastery .. "/" .. req .. ")")
                            if FunctionsHandler.LevelFarm and FunctionsHandler.LevelFarm.Methods and FunctionsHandler.LevelFarm.Methods.Start then
                                pcall(function() FunctionsHandler.LevelFarm.Methods.Start:Call() end)
                            end
                            return
                        end
                    end
                end

                -- 2. [km22] Chon vo theo THU TU CHUOI MeleeChain (Hac Cuoc -> Dien -> Nguoi Ca ->
                -- Hoi Tho Rong -> Sieu Nhan -> ...), KHONG quet MeleesTable lung tung nua.
                local npcPositions = MeleeNpcInfo
                local GetCurAmount = MeleeCurAmount
                local MeleeMissing = MeleePriceMissing

                if not MeleeEvalTick or os.time() - MeleeEvalTick >= 1 then
                    MeleeEvalTick = os.time()
                    MeleeEvalCache = EvalMeleeTarget()
                end
                local ev = MeleeEvalCache or EvalMeleeTarget()

                -- [km22] Log bang kiem tra (toi da 1 lan / 30s)
                if not MeleeScanTick or os.time() - MeleeScanTick > 30 then
                    MeleeScanTick = os.time()
                    local lines = {}
                    for _, mName in ipairs(MeleeChain) do
                        local md = MeleePrices and MeleePrices[mName]
                        local mLvl = GetPlayerMeleeMastery(mName)
                        local mReq = (md and md.NextLevelRequirement) or 400
                        local mInfo = MeleeNpcInfo[mName]
                        local here = MeleeNpcReachable(mName)
                        local note = "[NPC " .. (here and "CO o day" or "khong co o day") .. "] "
                        if mLvl >= mReq then
                            note = note .. "du mastery (" .. mLvl .. "/" .. mReq .. ")"
                        elseif not MeleeIsOwned(mName) then
                            note = note .. "chua co vo | Sea " .. tostring(mInfo and mInfo.Sea or "?") ..
                                " (" .. tostring(mInfo and mInfo.Npc) .. ") | " ..
                                tostring(MeleePrereqMissing(mName) or MeleePriceMissing(mName) or "du dieu kien, can den check tan noi")
                        else
                            note = note .. "da co, cay mastery " .. mLvl .. "/" .. mReq
                        end
                        table.insert(lines, "\n  " .. mName .. ": " .. note)
                    end
                    print("[MeleeCheck] chuoi vo (dang o Sea " .. tostring(SeaIndex) .. "):" .. table.concat(lines, ""))
                    print("[MeleeCheck] NPC dang co trong server nay: " .. ListNpcNames())
                end

                if not ev then
                    -- Toan bo chuoi da du mastery -> khong con gi de lam
                    SetTask("MainTask", "[km34] Melee | da du mastery toan bo chuoi vo")
                    SetTask("SubTask", "Chuyen sang fam cap / nguyen lieu")
                    ScriptStorage.IsGettingMelee = false
                    if FunctionsHandler.LevelFarm and FunctionsHandler.LevelFarm.Methods and FunctionsHandler.LevelFarm.Methods.Start then
                        pcall(function() FunctionsHandler.LevelFarm.Methods.Start:Call() end)
                    end
                    return
                end

                local targetMelee
                if not ev.pick then
                    -- [km22] Vo dau tien bi chan va CHANG co vo nao lay duoc ngay bay gio.
                    -- Bao ro ly do tren man hinh + fam dung loai nguyen lieu con thieu.
                    local f = ev.first
                    -- [DT3] "farm_fragments" = vo nay can DIEM F, ma raid la nguon F duy nhat
                    -- -> ghi lai de RaidController Refresh duoc nho 2 rang buoc cua ban cu
                    -- (chi dung trai trang + cho du 20 phut moi duoc mua chip bang Bel).
                    if f.action == "farm_fragments" then
                        local price = (MeleePrices and MeleePrices[f.name] and MeleePrices[f.name].Price) or {}
                        local canCo = tonumber(price.Fragments) or 0
                        local dangCo = tonumber(MeleeCurAmount and MeleeCurAmount("Fragments")) or 0
