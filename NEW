        M3 = M3 or {}

        -- Mot GUI chi "nhin thay duoc" neu toan bo chuoi cha cua no dang bat.
        function M3ChainVisible(inst)
            local ok, vis = pcall(function()
                local cur = inst
                for _ = 1, 10 do
                    if not cur then return false end
                    if cur:IsA("LayerCollector") then
                        return cur.Enabled ~= false
                    end
                    if cur:IsA("GuiObject") and cur.Visible == false then
                        return false
                    end
                    if not cur.Parent then return false end
                    cur = cur.Parent
                end
                return false
            end)
            return (ok and vis) == true
        end

        -- Moi TextLabel dang hien trong PlayerGui (tru GUI "CyndralDev" cua chinh
        -- hub), cache 8s. Quet descendants vi HUD co the nam sau Folder long nhau.
        function M3HudLabels()
            local now = os.clock()
            if M3.labels and M3.labelTick and (now - M3.labelTick < 8) then
                return M3.labels
            end
            M3.labelTick = now
            local out = {}
            pcall(function()
                local pgui = game.Players.LocalPlayer:FindFirstChild("PlayerGui")
                if not pgui then
                    if not M3.dumped then
                        M3.dumped = true
                        BaoM1("[M3] KHONG co PlayerGui -> khong doc duoc bang nhiem vu")
                    end
                    return
                end
                local scanned = 0
                for _, d in ipairs(pgui:GetDescendants()) do
                    scanned = scanned + 1
                    if scanned > 4000 then break end
                    if #out >= 300 then break end
                    if d:IsA("GuiObject") and M3ChainVisible(d) then
                        local cuaHub = false
                        local p = d
                        for _ = 1, 8 do
                            if not p then break end
                            if p.Name == "CyndralDev" then
                                cuaHub = true
                                break
                            end
                            p = p.Parent
                        end
                        if not cuaHub then
                            local t = d.Text
                            if type(t) == "string" and t ~= "" and #t < 80 then
                                table.insert(out, d)
                            end
                        end
                    end
                end
                if not M3.dumped then
                    M3.dumped = true
                    local mau = {}
                    for i = 1, math.min(#out, 12) do
                        table.insert(mau, out[i].Text)
                    end
                    BaoM1("[M3] HUD co " .. tostring(#out) .. " label | mau: " .. table.concat(mau, " / "))
                end
            end)
            M3.labels = out
            return out
        end

        -- "(0/8)" hoac "0/8" -> 0, 8. Chi so dung dem, KHONG phai so lo/nguyen lieu.
        function M3ParseXY(s)
            if type(s) ~= "string" then return nil end
            local c, t = string.match(s, "^%s*%((%d+)%s*/%s*(%d+)%)%s*$")
            if not c then
                c, t = string.match(s, "^%s*(%d+)%s*/%s*(%d+)%s*$")
            end
            if not c then return nil end
            return tonumber(c), tonumber(t)
        end

        -- Tim chu nhiem vu gan nhat voi label dem tien do (cung khung, toi 4 cap cha).
        function M3NearTitle(lbl)
            local ok, res = pcall(function()
                local node = lbl
                for _ = 1, 4 do
                    node = node.Parent
                    if not node then break end
                    local n = 0
                    for _, d in ipairs(node:GetDescendants()) do
                        n = n + 1
                        if n > 200 then break end
                        if d ~= lbl and d:IsA("GuiObject") and type(d.Text) == "string" and #d.Text < 60 then
                            local low = string.lower(d.Text)
                            if string.find(low, "efeat") or string.find(low, "ánh bại") or string.find(low, "đánh bại")
                                or string.find(low, "danh bai") or string.find(low, "nhiệm") or string.find(low, "quest")
                                or string.find(low, "tiêu diệt") or string.find(low, "kill") then
                                return d.Text
                            end
                        end
                    end
                end
                return nil
            end)
            return (ok and res) or nil
        end

        -- Tra: coNhiemVu, cur, max, title, nguon. Duong dan "an han" 12s sau khi vua
        -- gui lenh nhan (HUD cap nhat cham hon remote tra loi).
        function M3PanelNhiemVu(force)
            if force then
                M3.panelTick = nil
                M3.labelTick = nil
            end
            local now = os.clock()
            if not force and M3.panel and M3.panelTick and (now - M3.panelTick < 3) then
                local p = M3.panel
                return p[1], p[2], p[3], p[4], p[5]
            end
            M3.panelTick = now
            local coQuest, cur, max, title, nguon = false, nil, nil, nil, nil

            -- 1. Panel cu (van dung tren ban game cu)
            pcall(function()
                local q = game.Players.LocalPlayer.PlayerGui.Main.Quest
                if q and q.Visible then
                    coQuest = true
                    nguon = "PlayerGui.Main.Quest"
                end
            end)

            -- 2. Quet HUD tim dem "x/y" (build moi khong con panel tren)
            if not coQuest then
                for _, lbl in ipairs(M3HudLabels()) do
                    local c, t = M3ParseXY(lbl.Text)
                    if c and t and t >= 2 and t <= 60 and c <= t then
                        coQuest = true
                        cur, max = c, t
                        title = M3NearTitle(lbl) or lbl.Text
                        nguon = "HUD x/y"
                        break
                    end
                end
            end

            -- 3. An han sau khi vua claim
            if not coQuest and M3.graceUntil and now < M3.graceUntil then
                coQuest = true
                title = M3.graceTitle
                nguon = "an han " .. tostring(math.ceil(M3.graceUntil - now)) .. "s"
            end

            M3.panel = { coQuest, cur, max, title, nguon }
            return coQuest, cur, max, title, nguon
        end

        -- "Defeat 8 Dragon Crew Archer (0/8)" -> "Dragon Crew Archer".
        -- So voi ten quai trong BuiltInQuests truoc, fail thi so voi model that
        -- dang co mat trong workspace.Enemies (game dat ten khac bang cua ta).
        function M3TenQuaiTuTitle(title)
            if type(title) ~= "string" or title == "" then return nil end
            local low = string.lower(title)
            local best = nil
            pcall(function()
                for _, rows in pairs(BuiltInQuests or {}) do
                    for _, row in ipairs(type(rows) == "table" and rows or {}) do
                        for mobName in pairs(type(row) == "table" and row.Task or {}) do
                            local m = string.lower(mobName)
                            if m ~= "" and string.find(low, m, 1, true) then
                                if not best or #mobName > #best then
                                    best = mobName
                                end
                            end
                        end
                    end
                end
            end)
            if not best then
                pcall(function()
                    local ef = workspace:FindFirstChild("Enemies")
                    if not ef then return end
                    for _, e in ipairs(ef:GetChildren()) do
                        local n = string.lower(e.Name)
                        if n ~= "" and string.find(low, n, 1, true) then
                            if not best or #e.Name > #best then
                                best = e.Name
                            end
                        end
                    end
                end)
            end
            return best
        end

        -- Dem quai THAT dang co mat trong server, theo ten (cache 2s/moi ten).
        function M3CountLiveMob(mobName)
            if type(mobName) ~= "string" or mobName == "" then return 0 end
            local now = os.clock()
            M3.live = M3.live or {}
            local old = M3.live[mobName]
            if old and (now - old[2] < 2) then return old[1] end
            local want = string.lower(mobName)
            local n = 0
            pcall(function()
                local ef = workspace:FindFirstChild("Enemies")
                if not ef then return end
                for _, e in ipairs(ef:GetChildren()) do
                    local hum = e:FindFirstChildWhichIsA("Humanoid", true)
                    if hum and hum.Health > 0 and string.find(string.lower(e.Name), want, 1, true) then
                        n = n + 1
                    end
                end
            end)
            M3.live[mobName] = { n, now }
            return n
        end

        -- [M4] Toa do BAI QUAI gan nhat cua mot loai quai: lay model quai DANG SONO
        -- nhan vat nhat; neu khong thay con nao thi lay diem spawn trong
        -- ScriptStorage.MobRegions (scanner EnemySpawns/Locations luc inject). Cache 3s.
        -- Tra: viTri, khoangCach
        function M3ViTriBaiQuai(mobName)
            if type(mobName) ~= "string" or mobName == "" then return nil end
            local now = os.clock()
            M3.field = M3.field or {}
            local old = M3.field[mobName]
            if old and (now - old[2] < 3) then return old[1], old[3] end
            local best, bestD
            pcall(function()
                local char = game.Players.LocalPlayer.Character
                local myHrp = char and char:FindFirstChild("HumanoidRootPart")
                if not myHrp then return end
                local myPos = myHrp.Position
                local want = string.lower(mobName)
                local ef = workspace:FindFirstChild("Enemies")
                if ef then
                    for _, e in ipairs(ef:GetChildren()) do
                        local hum = e:FindFirstChildWhichIsA("Humanoid", true)
                        local eHrp = e:FindFirstChild("HumanoidRootPart")
                        if hum and hum.Health > 0 and eHrp and string.find(string.lower(e.Name), want, 1, true) then
                            local d = (eHrp.Position - myPos).Magnitude
                            if not best or d < bestD then
                                best, bestD = eHrp.Position, d
                            end
                        end
                    end
                end
                if not best and ScriptStorage.MobRegions then
                    local vung = ScriptStorage.MobRegions[mobName] or ScriptStorage.MobRegions[want]
                    if not vung then
                        for ten, ds in pairs(ScriptStorage.MobRegions) do
                            if string.find(string.lower(ten), want, 1, true) then
                                vung = ds
                                break
                            end
                        end
                    end
                    if vung then
                        for _, pos in ipairs(vung) do
                            if typeof(pos) == "Vector3" then
                                local d = (pos - myPos).Magnitude
                                if not best or d < bestD then
                                    best, bestD = pos, d
                                end
                            end
                        end
                    end
                end
            end)
            M3.field[mobName] = { best, now, bestD }
            return best, bestD
        end

        -- [FC4/PickLiveSeaMob] Chon loai quai DANG CO MAT o bien hien tai de LevelFarm
        -- khong bay toi toa do cu cua loai quai da ngung spawn -> dung im giua troi.
        function M3PickLiveSeaMob()
            local DaiBien = (QuestManager.BienTheoSea and QuestManager.BienTheoSea[SeaIndex]) or { Min = 0, Max = 99999 }
            local pLevel = (ScriptStorage.PlayerData and ScriptStorage.PlayerData.Level) or 1
            local best, bestReq, bestCount, bestId = nil, -1, 0, nil
            pcall(function()
                for qId, rows in pairs(BuiltInQuests or {}) do
                    for idx, row in ipairs(type(rows) == "table" and rows or {}) do
                        local req = tonumber(type(row) == "table" and row.LevelReq)
                        if req and req >= DaiBien.Min and req <= DaiBien.Max and req <= pLevel then
                            for mobName in pairs(type(row) == "table" and row.Task or {}) do
                                local c = M3CountLiveMob(mobName)
                                if c > 0 and (req > bestReq or (req == bestReq and c > bestCount)) then
                                    best, bestReq, bestCount, bestId = mobName, req, c, qId .. "-" .. tostring(idx)
                                end
                            end
                        end
                    end
                end
            end)
            return best, bestCount, bestReq, bestId
        end

        ScriptStorage.MobRegions = {}
        -- Dynamic Spawn Points Scanner for Sea 1, 2, 3
        pcall(function()
            for _, rootObj in pairs({workspace:FindFirstChild("_WorldOrigin"), workspace, game:GetService("ReplicatedStorage")}) do
                if rootObj then
                    local spawns = rootObj:FindFirstChild("EnemySpawns") or rootObj:FindFirstChild("Locations")
                    if spawns then
                        for _, spawnPart in pairs(spawns:GetChildren()) do
                            local name = spawnPart.Name
                            local pos = spawnPart:IsA("BasePart") and spawnPart.Position or (spawnPart:IsA("Model") and (spawnPart.PrimaryPart and spawnPart.PrimaryPart.Position or spawnPart:GetModelCFrame().Position))
                            if pos then
                                ScriptStorage.MobRegions[name] = ScriptStorage.MobRegions[name] or {}
