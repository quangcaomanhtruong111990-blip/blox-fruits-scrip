                -- [FC3] CHI NHAN NHIEM VU THAT BAI / chua tim duoc quai nhiem vu (MonName = nil)
                -- va CHAC CHAN dang khong co nhiem vu nao chay -> truoc day LevelFarm ket thuc
                -- thinh lang va de nhan vat dung yen o NPC (user: "vo thieu mastery la no dung
                -- yen o do, ko chi di fam"). Do la luc van can cay mastery / nguyen lieu / Beli
                -- -> danh con quai THAT SU dang co mat trong server sea nay.
                if not MonName and not hasActiveQuest then
                    local quLive = PickLiveSeaMob()
                    if quLive then
                        MonName = quLive
                        if not Fc3FallbackLog or os.time() - Fc3FallbackLog > 30 then
                            Fc3FallbackLog = os.time()
                            print("[FC3] Khong co nhiem vu dang chay + bang quest khong co ten quai -> fam " ..
                                tostring(quLive) .. " (cay mastery/Beli/nguyen lieu, khong dung yen)")
                        end
                    end
                end

                -- 2. Đánh quái cho đến khi hoàn thành 100% nhiệm vụ (tuyệt đối không bay về giữa chừng)
                if MonName then
