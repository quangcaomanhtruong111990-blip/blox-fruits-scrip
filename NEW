        function IsAnyQuestActive()
            local isVisible = false
            local rawText = ""
            pcall(function()
                local lp = game.Players.LocalPlayer
                local pGui = lp and lp:FindFirstChild("PlayerGui")
                if not pGui then return end

                local main = pGui:FindFirstChild("Main")
                local questGui = main and main:FindFirstChild("Quest")
                if questGui then
                    local container = questGui:FindFirstChild("Container")
                    local title = container and container:FindFirstChild("QuestTitle") and container.QuestTitle:FindFirstChild("Title")
                    local txt = title and title.Text or ""
                    
                    if (questGui.Visible or (container and container.Visible)) or (txt ~= "" and txt ~= "Quest Title") then
                        isVisible = true
                        rawText = txt
                    end
                end

                -- Fallback quét TextLabel trong PlayerGui nếu questGui bị ẩn property nhưng text hiển thị
                if not isVisible or rawText == "" then
                    for _, desc in ipairs(pGui:GetDescendants()) do
                        if desc:IsA("TextLabel") and desc.Visible and desc.Text and desc.Text ~= "" then
                            local t = desc.Text
                            if (string.find(t, "Defeat") or string.find(t, "Đánh bại")) and (string.find(t, "/%d+") or string.find(t, "%d+")) then
                                isVisible = true
                                rawText = t
                                break
                            end
                        end
                    end
                end
            end)
            return isVisible, rawText
        end

