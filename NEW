        function QuestMobFromUi()
            local now = os.clock()
            if QuestMobUiCache and (QuestMobUiCacheTime or 0) > now - 5 then
                return QuestMobUiCache
            end
            QuestMobUiCacheTime = now
            QuestMobUiCache = nil
            pcall(function()
                local titles = ScanQuestUiText() or ""
                local text = (titles .. " " .. tostring(BartiloUiKillText or "")):lower()
                if text == " " or text == "" then return end
                -- [km28] Danh sach ten quai lay tu: model dang spawn + Bang nhiem vu + toa do bai quai.
                -- O xa bãi Swan thi workspace.Enemies khong con model "Swan Pirate",
                -- nen chi quet model se khong tim thay -> phai co 2 nguon kia.
                -- [km29] GIOI HAN DUNG QU CUA SEA DANG CHO: truoc day lay ca BuiltInQuests
                -- nen "Bandit" (Sea 1) khop o Sea 2 -> bay toi toa do Sea 1 -> dung bang.
                local names = {}
                local enemies = workspace:FindFirstChild("Enemies")
                if enemies then
                    for _, e in ipairs(enemies:GetChildren()) do names[e.Name] = true end
                end
                local seaQuestIds = (SeaIndex == 1 and Sea1Quests) or (SeaIndex == 2 and Sea2Quests) or Sea3Quests
                for _, qId in ipairs(seaQuestIds or {}) do
                    for _, qData in ipairs((BuiltInQuests and BuiltInQuests[qId]) or {}) do
                        for mobName in pairs(qData.Task or {}) do names[mobName] = true end
                    end
                end
                if SeaIndex == 2 then
                    names["Swan Pirate"] = true
                    names["Jeremy"] = true
                end
                local seen, best, bestScore = {}, nil, 0
                for en in pairs(names) do
                    if not seen[en] then
                        seen[en] = true
                        local lower = en:lower()
                        local score = 0
                        if string.find(text, lower, 1, true) then
                            -- UI ghi ro toan bo ten quai ("Defeat 8 Ship Deckhands") -> khop manh nhat
                            score = 100 + #en
                        else
                            for word in string.gmatch(lower, "[%w%-']+") do
                                if #word >= 4 and not MOB_WORD_GENERIC[word] and string.find(text, word, 1, true) then
                                    score = score + 10 + #word
                                end
                            end
                        end
                        if score > bestScore then
                            bestScore = score
                            best = en
                        end
                    end
                end
                if best then QuestMobUiCache = best end
            end)
            return QuestMobUiCache
        end

