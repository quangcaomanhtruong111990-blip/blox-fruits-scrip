-- [km40] Do co combat cua CHINH GAME: client luu no trong env cua
-- PlayerGui.Main.Guide (_G.InCombat). Tra true/false, nil neu khong doc duoc.
function PlayerInCombat()
    local now = os.clock()
    if InCombatCacheTick and now - InCombatCacheTick < 1 then
        return InCombatCacheVal
    end
    InCombatCacheTick = os.clock()
    local ok, val = pcall(function()
        if type(getsenv) ~= "function" then return nil end
        local lp = game:GetService("Players").LocalPlayer
        local g = lp and lp:FindFirstChild("PlayerGui") and lp.PlayerGui:FindFirstChild("Main") and
            lp.PlayerGui.Main:FindFirstChild("Guide")
        if not g then return nil end
        local env = getsenv(g)
        return env and env._G and env._G.InCombat
    end)
    InCombatCacheVal = (ok and val) or nil
    -- [km41] O build nay PlayerGui.Main khong ton tai nen getsenv tra ve nil (log "InCombat=nil").
    -- Do luong cuoi: game HEN LO "In Combat" len man hinh luc dang chong mat, thu khi an ->
    -- tim chu nay trong danh sach label HUD da quet (GameHudLabels).
    if InCombatCacheVal == nil then
        local okH, hud = pcall(function()
            if type(GameHudLabels) ~= "function" then return nil end
            for _, lbl in ipairs(GameHudLabels()) do
                local low = string.lower(tostring(lbl.Text))
                if string.find(low, "combat") or string.find(low, "chiến") then
                    return true
                end
            end
            return false
        end)
        if okH and hud ~= nil then
            InCombatCacheVal = hud
            if not InCombatHudDumped then
                InCombatHudDumped = true
                print("[SeaTravel] Doc InCombat tu NHAN TIEN HUD (getsenv khong dung duoc) = " .. tostring(hud))
            end
        end
    end
    return InCombatCacheVal
end

