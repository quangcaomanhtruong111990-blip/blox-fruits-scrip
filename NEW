        -- Tra (ToSea, RemoteName) neu du dieu kien sang bien; nil neu khong can di.
        function SeaTravelTarget()
            if Config.Items and Config.Items.AutoSeaTravel == false then
                return nil
            end
            local pLvl = (ScriptStorage.PlayerData and ScriptStorage.PlayerData.Level) or 0
            -- [DT2] da ve duoc Sea 2 thi xoa dong ho "khong di duoc" ben duoi
            if SeaIndex ~= 3 then
                Dt2BackSea2At = nil
            end
            local thieuSea2 = GodhumanConThieuSea2()
            if pLvl >= 700 and SeaIndex == 1 then
                return 2, "TravelDressrosa"
            elseif pLvl >= 1500 and SeaIndex == 2 then
                local iceDoor = false
                pcall(function()
                    iceDoor = workspace.Map.IceCastle.Hall.LibraryDoor:FindFirstChild("PhoeyuDoor") ~= nil
                end)
                if iceDoor then
                    if not SeaTravelDoorLogTick or os.time() - SeaTravelDoorLogTick >= 60 then
                        SeaTravelDoorLogTick = os.time()
                        print("[SeaTravel] CON TUA Library (PhoeyuDoor) -> tam dung o Sea 2, xong Ice V2 roi moi di Sea 3")
                    end
                    return nil
                end
                -- [DT2] CON THIEU NGUYEN LIEU SEA 2 -> O LAI DAY fam, khong keo ve Sea 3 nua
                if thieuSea2 then
                    Dt2Bao("[DT2] O LAI Sea 2 fam nguyen lieu: " .. Dt2TenMat(thieuSea2))
                    return nil
                end
                return 3, "TravelZou"
            elseif pLvl >= 700 and SeaIndex == 3 and thieuSea2 then
                -- [DT2] dang o Sea 3 ma con thieu nguyen lieu Sea 2 -> VE Sea 2 (lenh nay
                -- SoulGuitar cua ban nay da dung tu lau). Neu 150s van chua di duoc thi nghi
                -- 30 phut roi thu lai, de khong spam TravelDressrosa moi tick.
                if Dt2BackSea2Until and os.time() < Dt2BackSea2Until then
                    return nil
                end
                if not Dt2BackSea2At then
                    Dt2BackSea2At = os.time()
                    Dt2Bao("[DT2] VE Sea 2 fam nguyen lieu: " .. Dt2TenMat(thieuSea2), 0)
                elseif os.time() - Dt2BackSea2At > 150 then
                    Dt2BackSea2At = nil
                    Dt2BackSea2Until = os.time() + 1800
                    Dt2Bao("[DT2] khong ve duoc Sea 2 (van o Sea 3 sau 150s) -> thu lai sau 30 phut", 0)
                    return nil
                end
                return 2, "TravelDressrosa"
            end
            return nil
        end

        -- [km44] TrySeaTravel KHONG CON chan thao tac nao nua: chi goi lenh dich trong
        -- background (khoa 12s/lan). Server bao "combat" -> bo qua, fam tiep, lan sau thu.
        -- (km42/43 ning 45s + bay cao 250 studs => nhan vat dung im, trai nguoi dung yeu cau)
        function TrySeaTravel(ToSea, RemoteName)
            local now = os.time()
            local pLvl = (ScriptStorage.PlayerData and ScriptStorage.PlayerData.Level) or 0
            SeaTravelTries = SeaTravelTries or {}

            if SeaTravelGiveUpUntil and now < SeaTravelGiveUpUntil then
                return false
            end
            local tries = SeaTravelTries[RemoteName] or 0
            if tries >= 12 then
                SeaTravelGiveUpUntil = now + 90
                SeaTravelTries[RemoteName] = 0
                print("[SeaTravel] " .. RemoteName .. " bi tu choi " .. tostring(tries) ..
                    " lan -> nghi 90s, fam tiep o Sea " .. tostring(SeaIndex))
                return false
            end
            if not LastSeaTravelTime or now - LastSeaTravelTime > 12 then
                LastSeaTravelTime = now
                SeaTravelTries[RemoteName] = tries + 1
                local okT, respT = pcall(function()
                    return Remotes.CommF_:InvokeServer(RemoteName)
                end)
                print("[SeaTravel] " .. RemoteName .. " (lan " .. tostring(tries + 1) .. ") -> " ..
                    (okT and ("tra:" .. tostring(respT)) or ("LOI:" .. tostring(respT))) ..
                    " | van o Sea " .. tostring(SeaIndex) .. " | cap " .. tostring(pLvl) ..
                    " | (khong dung im nua, van fam binh thuong)")
            end
            return true
        end

        -- Goi moi tick tu vong lap chinh.
        function SeaTravelTick()
            local toSea, remote = SeaTravelTarget()
            if not toSea then
                return
            end
            TrySeaTravel(toSea, remote)
        end

        
