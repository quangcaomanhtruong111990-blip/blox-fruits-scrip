        function ReadMeleeMasteryHud()
            local now = os.clock()
            if (now - MeleeHudMasteryTick) < 10 then return MeleeHudMastery end
            MeleeHudMasteryTick = now

            local found = {}
            pcall(function()
                local lp = game:GetService("Players").LocalPlayer
                local pg = lp and (lp:FindFirstChild("PlayerGui") or lp:WaitForChild("PlayerGui", 5))
                if not pg then return end
                for _, lbl in ipairs(pg:GetDescendants()) do
                    local isText = false
                    pcall(function() isText = lbl:IsA("GuiText") end)
                    if isText then
                        local txt = nil
                        pcall(function() txt = lbl.Text end)
                        if type(txt) == "string" and #txt > 4 and string.find(txt, ":", 1, true) then
                            local sg = nil
                            pcall(function() sg = lbl:FindFirstAncestorOfClass("ScreenGui") end)
                            local gname = string.lower(tostring(sg and sg.Name or ""))
                            -- GUI cua hub cung co cho "Black Leg: 401" -> bo qua de khong
                            -- doc lai chinh gia tri sai cua no (vong tron thong tin)
                            if gname ~= "cyndraldev"
                                and string.find(gname, "bocchi", 1, true) == nil
                                and string.find(gname, "hub", 1, true) == nil then
                                for rawName, rawVal in string.gmatch(txt, "([%a][%a%s%'%-]*):%s*(%d+)") do
                                    local key = MeleeHudKey(rawName)
                                    local val = tonumber(rawVal)
                                    if val and #key > 2 then
                                        for styleName, aliases in pairs(MeleeToolAliases) do
                                            for _, al in ipairs(aliases) do
                                                if MeleeHudKey(al) == key then
                                                    if not found[styleName] or found[styleName] < val then
                                                        found[styleName] = val
                                                    end
                                                    break
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end)

            for styleName, val in pairs(found) do
                if MeleeHudMastery[styleName] ~= val then
                    MeleeHudMastery[styleName] = val
                    print("[Vo HUD] " .. styleName .. " = " .. val .. " (doc tu HUD game)")
                end
            end
            return MeleeHudMastery
        end

