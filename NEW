TraiTrangMacDinh = {
    "Kilo-Kilo", "Bone-Bone", "Rocket-Rocket", "Spin-Spin", "Chop-Chop", "Blast-Blast",
    "Spring-Spring", "Cube-Cube", "Sword-Sword", "Ice-Ice", "Door-Door", "Dark-Dark",
    "Light-Light", "Sand-Sand", "Blade-Blade", "Falcon-Falcon",
}
TraiCuiTen = TraiTrangMacDinh

local function NormTenTrai(s)
    local t = string.gsub(string.lower(tostring(s or "")), "[^%a0-9]", "")
    -- "Rocket Fruit" / "Rocket-Rocket" / "Rocket" cung ra "rocket"
    t = string.gsub(t, "fruit$", "")
    return t
end

function TraiLoaiTrang(ten)
    if type(ten) ~= "string" or ten == "" then
        return false
    end
    local them = (Config and Config.Raid and Config.Raid.WhiteFruits) or {}
    if not TraiTrangSet or TraiTrangSetN ~= #them then
        local t = {}
        for _, n in ipairs(TraiTrangMacDinh) do
            -- "Rocket-Rocket" -> can "rocket" (ten trong balo/thuong chi la "Rocket Fruit")
            local base = NormTenTrai(string.match(tostring(n), "^([^-]+)") or n)
            if base ~= "" then
                t[base] = true
            end
        end
        for _, n in ipairs(them) do
            local base = NormTenTrai(string.match(tostring(n), "^([^-]+)") or n)
            if base ~= "" then
                t[base] = true
            end
        end
        TraiTrangSet = t
        TraiTrangSetN = #them
    end
    local k = NormTenTrai(ten)
    if k == "" then
        return false
    end
    for base in pairs(TraiTrangSet) do
        if string.sub(k, 1, #base) == base then
            return true
        end
    end
    return false
end

-- Lieat ke trai dang nam trong kho: thu Data.Fruits (client) roi toi remote getInventoryFruits
function TraiTrongKho(luc)
    if not luc and TraiKhoCache and (os.clock() - (TraiKhoCacheTick or 0)) < 10 then
        return TraiKhoCache
    end
    local out = {}
    local seen = {}
    local function Them(ten, price)
        if type(ten) ~= "string" or ten == "" or seen[ten] then
            return
        end
        seen[ten] = true
        table.insert(out, {Name = ten, Type = "Blox Fruit", Price = tonumber(price) or 0, FromStorage = true})
    end
    local lp = game:GetService("Players").LocalPlayer
    pcall(function()
        local data = lp and lp:FindFirstChild("Data")
        local dv = data and data:FindFirstChild("Fruits")
        if dv then
            local val = nil
            pcall(function()
                val = dv.Value
            end)
            if typeof(dv) == "StringValue" and type(val) == "string" then
                for part in string.gmatch(val, "[^;,]+") do
                    local clean = string.match(part, "^%s*(.-)%s*$")
                    if clean and clean ~= "" then
                        Them(clean, 0)
                    end
                end
            elseif typeof(dv) == "Folder" then
                for _, c in ipairs(dv:GetChildren()) do
                    Them(c.Name, 0)
                end
            end
        end
    end)
    if #out == 0 and Remotes and Remotes.CommF_ then
        pcall(function()
            local list = Remotes.CommF_:InvokeServer("getInventoryFruits")
            if type(list) == "table" then
                for _, v in pairs(list) do
                    if type(v) == "table" and v.Name then
                        Them(tostring(v.Name), v.Price or v.Value)
                    end
                end
            end
        end)
    end
    if #out == 0 and Remotes and Remotes.CommF_ then
        pcall(function()
            local list = Remotes.CommF_:InvokeServer("getInventory")
            if type(list) == "table" then
                for _, v in pairs(list) do
                    if type(v) == "table" and v.Name and (v.Type == "Blox Fruit" or string.find(tostring(v.Name), "-")) then
                        Them(tostring(v.Name), v.Price or v.Value)
                    end
                end
            end
        end)
    end
    TraiKhoCache = out
    TraiKhoCacheTick = os.clock()
    if #out == 0 and not TraiKhoEmptyDumped then
        TraiKhoEmptyDumped = true
        local tenData = {}
        pcall(function()
            local data = lp and lp:FindFirstChild("Data")
            if data then
                for _, c in ipairs(data:GetChildren()) do
                    table.insert(tenData, c.Name .. "(" .. c.ClassName .. ")")
                end
            end
        end)
        local tenNet = {}
        pcall(function()
            local mods = game:GetService("ReplicatedStorage"):FindFirstChild("Modules")
            local net = mods and mods:FindFirstChild("Net")
            if net then
                for _, c in ipairs(net:GetChildren()) do
                    table.insert(tenNet, c.Name)
                end
            end
        end)
        print("[KhoTrai] KHONG liet ke duoc trai trong kho | LocalPlayer.Data: " .. table.concat(tenData, ", "))
        print("[KhoTrai] ReplicatedStorage.Modules.Net: " ..
            (next(tenNet) and table.concat(tenNet, ", ") or "khong co Modules.Net"))
        print("[KhoTrai] -> se THU CU SOA tung ten trai cui qua LoadFruit (khong can danh sach)")
    end
    return out
end

function DemTraiVatLy()
    local n = 0
    local lp = game:GetService("Players").LocalPlayer
    pcall(function()
        for _, Holder in {lp:FindFirstChild("Backpack"), lp.Character} do
            if Holder then
                for _, Item in ipairs(Holder:GetChildren()) do
