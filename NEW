                            string.format("%.0f", idleFor) .. "s (khong cuong buc vi dang theo chuoi)")
                    end
                    return
                end
                if Fc6KickAt and (now - Fc6KickAt) < 25 then return end
                Fc6KickAt = now
                print("[FC6] watchdog: task '" .. tostring(winnerName) .. "' giu tick " ..
