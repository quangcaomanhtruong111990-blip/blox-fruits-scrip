        function Fc6Watchdog(winnerName)
            if _G.Stop or not winnerName or winnerName == "LevelFarm" then
                return
            end
            pcall(function()
                if FunctionsHandler.RaidController and FunctionsHandler.RaidController:Get("IsInRaidProcess") then
                    return
                end
                if FunctionsHandler.Trevor and FunctionsHandler.Trevor.Get and
                    FunctionsHandler.Trevor:Get("IsLoadingFruit") then
                    return
                end
                local char = game.Players.LocalPlayer and game.Players.LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                local now = os.clock()
                local pos = hrp.Position
                if Fc6LastPos and (pos - Fc6LastPos).Magnitude > 12 then
                    Fc6MovedAt = now
                elseif not Fc6MovedAt then
                    Fc6MovedAt = now
                end
                Fc6LastPos = pos
                local idleFor = now - math.max(tonumber(getgenv().Fc6LastAttack) or 0, Fc6MovedAt or now)
                if idleFor <= 25 then
                    Fc6Warned = nil
                    return
                end
                local longGrace = Fc6LongGrace[winnerName]
                if longGrace and idleFor < longGrace then
                    if not Fc6Warned or (pos - Fc6Warned).Magnitude > 40 then
                        Fc6Warned = pos
                        print("[FC6] task '" .. tostring(winnerName) .. "' dung " ..
                            string.format("%.0f", idleFor) .. "s (dang tai NPC/boss -> cho den " ..
                            tostring(longGrace) .. "s roi moi fam cuong buc)")
                        SetTask("SubTask", "[FC6] " .. tostring(winnerName) .. " dung " ..
                            string.format("%.0f", idleFor) .. "s tai NPC/boss -> chua keo di (duoi " ..
                            tostring(longGrace) .. "s)")
                    end
                    return
                end
                if Fc6NoForce[winnerName] then
                    if not Fc6Warned or (pos - Fc6Warned).Magnitude > 40 then
                        Fc6Warned = pos
                        print("[FC6] task '" .. tostring(winnerName) .. "' dung " ..
                            string.format("%.0f", idleFor) .. "s (puzzle/raid -> KHONG xen vao)")
