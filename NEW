        -- [km45] memo 1s -> 4s (config: Config.Settings.QuestProgressMemo)
        function QuestProgressFromHud()
            local now = os.clock()
            if QuestHudCacheTick and (now - QuestHudCacheTick < (tonumber(Config and Config.Settings and Config.Settings.QuestProgressMemo) or 4)) then
                local c = QuestHudCache
                return c[1], c[2], c[3]
            end
            QuestHudCacheTick = now
            local bestC, bestT, bestTitle, bestLbl = nil, nil, nil, nil
            local xySeen = {}
            for _, lbl in ipairs(GameHudLabels()) do
                local c, t = ParseQuestXY(lbl.Text)
                if c and t and t >= 2 and t <= 60 and c <= t then
                    table.insert(xySeen, lbl.Text)
                    if not bestLbl then
                        bestC, bestT, bestTitle, bestLbl = c, t, NearQuestTitle(lbl), lbl
                    end
                end
            end
            if bestLbl and not QuestHudDumped then
                QuestHudDumped = true
                print("[QuestUi] Panel nhiem vu: " .. bestLbl:GetFullName() .. " = " .. bestLbl.Text ..
                    " | title = " .. tostring(bestTitle))
            end
            if not bestLbl and not QuestHudEmptyDumped then
                QuestHudEmptyDumped = true
                print("[QuestUi] KHONG tim thay dem x/y nao trong HUD game. So label quet duoc = " ..
                    tostring(#GameHudLabels()))
            end
            QuestHudCache = { bestC, bestT, bestTitle }
            return bestC, bestT, bestTitle, bestLbl
        end

