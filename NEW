        function ParseQuestXY(s)
            if type(s) ~= "string" then return nil end
            local c, t = string.match(s, "^%s*%((%d+)%s*/%s*(%d+)%)%s*$")
            if not c then
                c, t = string.match(s, "^%s*(%d+)%s*/%s*(%d+)%s*$")
            end
            if not c then return nil end
            return tonumber(c), tonumber(t)
        end

        -- Tim chu nhiem vu gan nhat voi label dem tien do ( cung khung, toi 4 cap cha)
        function NearQuestTitle(lbl)
            local ok, res = pcall(function()
                local node = lbl
                for _ = 1, 3 do
                    node = node.Parent
                    if not node then break end
                    local scanned = 0
                    for _, d in ipairs(node:GetDescendants()) do
                        scanned = scanned + 1
                        if scanned > 250 then break end
                        if d ~= lbl and d:IsA("GuiObject") and type(d.Text) == "string" and #d.Text < 60 then
                            local low = string.lower(d.Text)
                            if string.find(low, "efeat") or string.find(low, "đánh") or string.find(low, "danh")
                                or string.find(low, "tiêu") or string.find(low, "nhiệm") or string.find(low, "quest")
                                or string.find(low, "kill") or string.find(low, "def") then
                                return d.Text
                            end
                        end
                    end
                end
                return nil
            end)
            return ok and res or nil
        end

