        -- [km41] SUA LOC: GetAttributes() tra ve BANG HASH nen "ipairs" luon duyet 0 phan
        -- -> khong bao gio bat duoc attribute nao. Doi sang pairs va cham tiep gia tri.
        function IsFruitDrop(obj)
            local ok, res = pcall(function()
                if type(obj) ~= "table" or not obj:IsA("Instance") then return false end
                if string.find(string.lower(obj.Name), "fruit") then return true end
                if obj:IsA("Tool") then
                    local tip = string.lower(tostring(obj.ToolTip or ""))
                    if string.find(tip, "fruit") then return true end
                end
                local okA, attrs = pcall(function() return obj:GetAttributes() end)
                if okA and type(attrs) == "table" then
                    for k, v in pairs(attrs) do
                        if string.find(string.lower(tostring(k)), "fruit") or
                            (type(v) == "string" and string.find(string.lower(v), "fruit")) then
                            return true
                        end
                    end
                end
                return false
            end)
            return (ok and res) == true
        end

