        -- CatTraiVaoRuong: cất mọi Tool trái ác quỷ đang nằm tay/trong balo vào Treasure Inventory
        function CatTraiVaoRuong()
            -- [km47] DAO NGUOC km43: trai TRANG giu lai balo de RAID, con trai XANH/TIM/DO
            -- thi cat nguoc vao kho lien de khong ai dung mat duoc.
            local chiCatTraiKhacTrang = RaidUsesStoredFruits() and RaidChiDungTraiTrang()
            if not CatTraiModeLogged then
                CatTraiModeLogged = true
                print("[Trai] [km47] Cat vao kho: " .. (chiCatTraiKhacTrang and
                    "CHI cat trai KHAC trang (giu trai trang cho RAID)" or "tat ca"))
            end
            local Stored = 0
            local lp = game:GetService("Players").LocalPlayer
            if not (lp and Remotes and Remotes.CommF_) then
                return 0
            end
            local Holders = {lp:FindFirstChild("Backpack"), lp.Character}
            for _, Holder in ipairs(Holders) do
                if Holder then
                    for _, Item in ipairs(Holder:GetChildren()) do
                        local okTool, isTool = pcall(function() return Item:IsA("Tool") end)
                        if okTool and isTool then
                            local okAttr, original = pcall(function() return Item:GetAttribute("OriginalName") end)
                            local okTip, tip = pcall(function() return Item.ToolTip end)
                            local isFruit = (okAttr and original ~= nil) or
                                string.find(tostring(Item.Name), "Fruit", 1, true) or
                                (okTip and tip == "Blox Fruit")
                            if isFruit then
                                local Name = original or tostring(Item.Name)
                                if (chiCatTraiKhacTrang and TraiLoaiTrang(Name)) then
                                    -- [km47] trai trang -> GIU LAI balo de mo RAID
                                elseif Config and Config.Items and table.find(Config.Items.Eatlist or {}, Name) then
                                    -- để trái trong Eatlist nằm lại cho luồng tự ăn
                                    print("[Trai] Bo qua (Eatlist): " .. Name)
                                else
                                    local blocked = (FruitStoreFail or {})[Name]
                                    if type(blocked) == "number" and blocked > os.time() then
                                        -- trái này đã cất thất bại gần đây, không gọi lại cho đỡ spam
                                    elseif table.find(ScriptStorage.IgnoreStoreFruits, Name) or
                                        Name == RaidFruitHoldName then
                                        -- [km43] trai dang phuc vu RAID -> khong cat
                                    else
                                        if type(blocked) == "number" then
                                            FruitStoreFail[Name] = nil
                                        end
                                        local okCall, resp = pcall(function()
                                            return Remotes.CommF_:InvokeServer("StoreFruit", original or Name, Item)
                                        end)
                                        -- Server chỉ thực sự cất khi Tool bị xoá khỏi balo/tay
                                        local Gone = false
                                        local Deadline = tick() + 2
                                        repeat
                                            task.wait(0.1)
                                            Gone = (Item.Parent == nil)
                                        until Gone or tick() > Deadline
                                        if Gone then
                                            Stored = Stored + 1
                                            print("[Trai] Da cat vao kho: " .. Name .. " -> " .. tostring(resp))
                                        else
                                            FruitStoreFail = FruitStoreFail or {}
                                            FruitStoreFail[Name] = os.time() + 600
                                            print("[Trai] THAT BAI: " .. Name ..
                                                " van con trong balo (StoreFruit tra: " .. tostring(resp) ..
                                                ") -> bo qua 10 phut")
                                        end
                                        task.wait(0.2)
                                    end
                                end
                            end
                        end
                    end
                end
            end
            if Stored > 0 then
                pcall(RefreshInventory)
                print("[Trai] Da cat " .. tostring(Stored) .. " qua vao Treasure Inventory")
            end
            return Stored
        end

        -- Server từ chối bằng nil / false / {Success=false} -> phải coi là THẤT BẠI
        function GachaRejected(Value)
            if Value == nil or Value == false then
                return true
            end
            if typeof(Value) == "table" then
                if Value.Success == false or Value.success == false then
                    return true
                end
                if Value.Name == nil and Value.Fruit == nil and Value.Item == nil and next(Value) == nil then
                    return true
                end
            end
            if typeof(Value) == "string" and Value == "" then
                return true
            end
            return false
        end

        function TimTraiNgauNhien()
            if not (Remotes and Remotes.CommF_) then
                return nil, "khong tim thay CommF_", "khong co remote"
            end
            -- 1. Buy cua NPC Cousin (game version cũ)
            local ok1, resp1 = pcall(function()
                return Remotes.CommF_:InvokeServer("Cousin", "Buy")
            end)
            if ok1 and not GachaRejected(resp1) then
                return resp1, "Cousin,Buy"
            end
            -- 2. Fallback: remote gacha mới (RF/GachaNetworkRF)
            local ok2, resp2 = pcall(function()
                local modules = game:GetService("ReplicatedStorage"):FindFirstChild("Modules")
                local net = modules and modules:FindFirstChild("Net")
                local rf = net and net:FindFirstChild("RF/GachaNetworkRF")
                if not rf then
                    return nil
                end
                return rf:InvokeServer({Context = "Purchase", BoxName = "ZiolesGacha"})
            end)
            if ok2 and not GachaRejected(resp2) then
                return resp2, "RF/GachaNetworkRF"
            end
            -- [km36] phan biet "server tra ve nil/false" (TU CHOI) voi "pcall loi"
            local function fmt(okv, v)
                if not okv then return "LOI:" .. tostring(v) end
                return "tra:" .. tostring(v)
            end
            local Reason = "Cousin,Buy=" .. fmt(ok1, resp1) .. " | GachaNetworkRF=" .. fmt(ok2, resp2)
            return nil, "ca 2 lenh", Reason
        end

