        function CombatController.Search(MobTable)
            MobTable = type(MobTable) == "string" and {MobTable} or (MobTable or {})
            local Lists = {}
            local Found = false
            for _, ChildInstance in GetMonAsSortedRange() do
                if ChildInstance and ChildInstance:FindFirstChild("Humanoid") and ChildInstance.Humanoid.Health > 0 then
                    local isTarget = false
                    for _, targetName in ipairs(MobTable) do
                        if IsMobMatch(ChildInstance.Name, targetName) then
                            isTarget = true
                            break
                        end
                    end
                    if isTarget then
                        if (ChildInstance:GetAttribute("FailureCount") or 0) < 3 then
                            Found = true
                            table.insert(Lists, ChildInstance)
                        end
                    end
                end
            end

            table.sort(
                Lists,
                function(a, b)
                    return Sort1(a) < Sort1(b)
                end
            )

            if Found then
                local Mon1 = Lists[1]
                return Mon1
            end

            return nil
        end

