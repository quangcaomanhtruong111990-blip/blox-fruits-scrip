        local function CleanQuestMobTitle(rawText)
            if not rawText or rawText == "" then return "" end
            local str = tostring(rawText)

            -- 1. Xóa các tiền tố nhận nhiệm vụ thường gặp
            str = str:gsub("^%s*[Dd]efeat%s*%d*%s*", "")
            str = str:gsub("^%s*[Đđ]ánh%s*bại%s*%d*%s*", "")
            str = str:gsub("^%s*[Kk]ill%s*%d*%s*", "")
            str = str:gsub("^%s*[Tt]iêu%s*diệt%s*%d*%s*", "")

            -- 2. Xóa các chỉ số tiến độ nhiệm vụ dạng (0/5), 0/5, [0/5], ( 0 / 5 )
            str = str:gsub("%s*%b()", "")
            str = str:gsub("%s*%b[]", "")
            str = str:gsub("%s*%d+%s*/%s*%d+%s*", "")

            -- 3. Xóa các tag cấp độ [Lv. 100], Lv. 100
            str = str:gsub("%s*%[Lv%.?%s*%d+%]%s*", "")
            str = str:gsub("%s*Lv%.?%s*%d+%s*", "")

            -- 4. Trim khoảng trắng đầu/cuối
            str = str:gsub("^%s*(.-)%s*$", "%1")

            -- 5. Ánh xạ tiếng Việt sang tên quái tiếng Anh chuẩn
            if VietnameseToEnglishMob[str] then
                str = VietnameseToEnglishMob[str]
            else
                local lowStr = string.lower(str)
                for vnName, engName in pairs(VietnameseToEnglishMob) do
                    local lowVn = string.lower(vnName)
                    if lowStr == lowVn or string.find(lowStr, lowVn, 1, true) or string.find(lowVn, lowStr, 1, true) then
                        str = engName
                        break
                    end
                end
            end

            -- 6. Chuẩn hóa số nhiều tiếng Anh (Bandits -> Bandit, Monkeys -> Monkey, Pirates -> Pirate, etc.)
            if str:sub(-1) == "s" and not str:match("ss$") and not str:match("us$") and not str:match("is$") then
                local singular = str:sub(1, -2)
                if (MobPositionsFallback and MobPositionsFallback[singular]) or (BuiltInQuests and BuiltInQuests[singular]) then
                    str = singular
                end
            end

            if type(str) == "string" then
                str = string.gsub(str, "Military ", "Mil. ")
            end

            return str
        end

        function QuestManager.GetCurrentClaimQuest(RawResponse)
            local isVisible = false
            local rawText = ""
            pcall(function()
                local questGui = game.Players.LocalPlayer.PlayerGui.Main.Quest
                isVisible = questGui and questGui.Visible
                if isVisible then
                    if questGui:FindFirstChild("Container") then
                        local container = questGui.Container
                        if container:FindFirstChild("QuestTitle") then
                            local qt = container.QuestTitle
                            if qt:FindFirstChild("Title") and qt.Title:IsA("TextLabel") and qt.Title.Text ~= "" then
                                rawText = qt.Title.Text
                            elseif qt:IsA("TextLabel") and qt.Text ~= "" then
                                rawText = qt.Text
                            end
                        end
                        if rawText == "" and container:FindFirstChild("Title") and container.Title:IsA("TextLabel") then
                            rawText = container.Title.Text
                        end
                    end
                    if rawText == "" then
                        for _, desc in ipairs(questGui:GetDescendants()) do
                            if desc:IsA("TextLabel") and desc.Text and desc.Text ~= "" then
                                if string.find(desc.Text, "Defeat") or string.find(desc.Text, "Đánh bại") or string.find(desc.Text, "/") then
                                    rawText = desc.Text
                                    break
                                end
                            end
                        end
                    end
                end
            end)

            if not isVisible or rawText == "" then
                return nil, nil
            end
            if RawResponse then
                return isVisible, rawText
            end

            local cleanTitle = CleanQuestMobTitle(rawText)
            return cleanTitle, rawText
        end

