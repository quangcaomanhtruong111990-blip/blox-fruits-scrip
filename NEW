        function Dt2CoQuaiLive(mobs)
            local ok, res = pcall(function()
                local enemies = workspace:FindFirstChild("Enemies")
                if not enemies then return nil end
                local set = {}
                for _, n in ipairs(mobs or {}) do
                    set[tostring(n)] = true
                end
                for _, e in ipairs(enemies:GetChildren()) do
                    if set[e.Name] and e:FindFirstChild("HumanoidRootPart") then
                        return e.Name
                    end
                end
                return nil
            end)
            return (ok and res) or nil
        end

