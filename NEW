                                -- [FC2] Nhiem vu dang danh CHUA xong (memo x < y) -> KHONG huy quest
                                -- de doi vo ngay; de no xong cai roi huy cung duoc (day la mot trong
                                -- 2 loi "7/8 bi nhan lai thanh 0/8").
                                local giuTd, memoTd2 = QuestGiuTienDo()
