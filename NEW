        function Split(inputstr, sep)
            if sep == nil then
                sep = "%s"
            end
            local t = {}
            for str in string.gmatch(inputstr, "([^" .. sep .. "]+)") do
                table.insert(t, str)
            end
            return t
        end

        function FruitNameToId(FruitName)
            local Id = Split(FruitName)[1]
            return Id .. "-" .. Id
        end

