                                        print("[Mastery Complete] Vo " .. tostring(curMelee) .. " da du mastery (" ..
                                            tostring(curMastery) .. "/" .. tostring(reqMastery) .. ") NHUNG nhiem vu " ..
                                            tostring(memoTd2.cur) .. "/" .. tostring(memoTd2.total) ..
                                            " chua xong -> danh xong roi moi huy quest doi vo")
                                    end
                                else
                                    print("[Mastery Complete] Võ " .. tostring(curMelee) .. " đã đủ Mastery (" .. tostring(curMastery) .. "/" .. tostring(reqMastery) .. ") -> Dừng farm ngay để nhận võ tiếp theo!")
                                    pcall(function() QuestManager.AbandonQuest() end)
                                    -- [km46] Huy quest de doi vo -> cho phep nhan nhiem vu moi lien sau do
                                    getgenv().LastStartQuestAt = nil
                                    getgenv().ForceNextQuestCheck = true
                                    getgenv().QuestProgMemo = nil
                                    task.wait(0.2)
                                    break
                                end
                            end
                        end

                        -- KIỂM TRA TIẾN ĐỘ NHIỆM VỤ:
                        -- [km46] Gan xong (con <=1 con theo dem lan cu) -> buoc HUD doc lai, nhung
                        -- toi da 1 LAN/GIAY (vong farm chay 20 tick/giay, ep moi tick = spam HUD).
                        local sapXong = (lastTotalKills and lastCurKills) and (lastTotalKills - lastCurKills <= 1)
                            and (not Config or not Config.Settings or Config.Settings.QuestDoneLookahead ~= false)
                        local buocDoc = false
                        if sapXong and (not LastHudForceTick or os.clock() - LastHudForceTick >= 1) then
                            LastHudForceTick = os.clock()
                            buocDoc = true
                        end
                        local isQuestActive, currentKills, totalKills = QuestManager.HasActiveQuest(buocDoc)

                        if isQuestActive then
                            noQuestGoneSince = nil -- Quest vẫn đang hoạt động, reset bộ đếm thời gian
                            if currentKills and totalKills and totalKills > 0 then
                                lastCurKills = currentKills
                                lastTotalKills = totalKills
                                -- [FC2] lam tuoi memo tien do (90s) -> biet nhiem vu van chua xong
                                GhiTienDoNhiemVu(currentKills, totalKills, MonName, QuestId)
                                -- Nếu đã đủ 100% số lượng quái yêu cầu (vd: 8/8) -> Hoàn thành nhiệm vụ!
                                if currentKills >= totalKills then
                                    getgenv().LastQuestClaimTick = nil
                                    getgenv().DynamicQuestGracePeriod = nil
                                    -- [km46] XONG NHIEM VU -> nhan lai LIEN TUC: xoa het lenh cho
                                    getgenv().LastStartQuestAt = nil
                                    getgenv().ForceNextQuestCheck = true
                                    print("[QuestState] XONG NHIEM VU " .. tostring(currentKills) .. "/" .. tostring(totalKills) .. " -> nhan nhiem vu moi lien")
                                    task.wait(0.1)
                                    break
                                end
                            end
                        else
                            -- Quest UI biến mất:
                            -- CHỈ xét hoàn thành khi NHÂN VẬT ĐÃ ĐẾN BÃI QUÁI (hasArrivedAtMob) và UI biến mất liên tục trong QuestGoneDelay
                            if not hasArrivedAtMob then
                                noQuestGoneSince = nil -- Đang trên đường bay tới bãi quái xa, không xác nhận mất quest!
                            elseif lastCurKills and lastTotalKills and lastCurKills < lastTotalKills then
                                -- Dù quái ít hay nhiều, nếu chưa đạt đủ số lượng yêu cầu (vd: 3/8) mà UI tạm ẩn, KHÔNG ĐƯỢC PHÉP hoàn thành sớm!
                                noQuestGoneSince = nil
                            else
                                local questGoneDelay = (Config and Config.Settings and tonumber(Config.Settings.QuestGoneDelay)) or 25
                                local minFarmDuration = (Config and Config.Settings and tonumber(Config.Settings.MinFarmDuration)) or 40
                                local farmingElapsed = os.time() - (arriveTime or farmMobStart)

                                if lastCurKills and lastTotalKills and lastCurKills < lastTotalKills then
                                    noQuestGoneSince = nil
                                else
                                    if not noQuestGoneSince then
                                        noQuestGoneSince = os.clock()
                                    elseif (os.clock() - noQuestGoneSince >= questGoneDelay) and (farmingElapsed >= minFarmDuration) then
                                        getgenv().LastQuestClaimTick = nil
                                        getgenv().DynamicQuestGracePeriod = nil
                                        -- [FC1] UI mat = co the da xong nhiem vu, nhung KHONG xoa
                                        -- LastStartQuestAt nua: giu lenh cho QuestTryGap (8s) de
                                        -- khong co chuyen "nhiem vu cu chua xong da nhan cai moi".
                                        -- Neu that su xong thi no chi cham hon 8s, khong mat gi.
                                        getgenv().ForceNextQuestCheck = true
                                        print("[QuestState] UI nhiem vu da mat " .. tostring(questGoneDelay) .. "s + da fam " .. tostring(farmingElapsed) .. "s -> nhan nhiem vu moi sau " .. tostring((Config and Config.Settings and tonumber(Config.Settings.QuestTryGap)) or 8) .. "s nua")
                                        break -- Thực sự đã hoàn thành nhiệm vụ!
                                    end
                                end
                            end
                        end

                        -- [km29] LOAI QUAI MUC TIEU KHONG CO TRONG SERVER NAY (chon nham quai sea khac,
                        -- bai quai bi stream an) -> thoat vong farm de chon lai muc tieu,
                        -- thay vi dung im bay di bay lai moi 0.05s.
                        if not LiveMobCheckTick or os.clock() - LiveMobCheckTick > 2 then
                            LiveMobCheckTick = os.clock()
                            local liveMob = false
                            pcall(function()
                                local ef = workspace:FindFirstChild("Enemies")
                                if ef then
                                    for _, e in ipairs(ef:GetChildren()) do
                                        if e.Name == MonName and e:FindFirstChild("Humanoid") and e.Humanoid.Health > 0 then
                                            liveMob = true
                                            break
                                        end
                                    end
                                end
                            end)
                            if liveMob then
                                noLiveMobSince = nil
                            elseif not noLiveMobSince then
                                noLiveMobSince = os.time()
                            elseif os.time() - noLiveMobSince >= 25 then
                                print("[LevelFarm] " .. tostring(MonName) .. " khong co trong server nay 25s -> chon lai muc tieu khac")
                                break
                            end
                        end

                        local AttackTime1 = os.time()
                        CombatController.Attack(MonName)
                        LevelFarmTTL = (LevelFarmTTL or 0) + os.time() - AttackTime1

                        -- Giới hạn an toàn tránh kẹt
                        if os.time() - farmMobStart > 300 then
                            break
                        end
                    end
                else
                    -- [DT3] KHONG CON TEN QUAI NAO DE DANH (MonName = nil). Truoc day doan nay
                    -- ket thuc IM LANG -> LevelFarm khong kip SetTask nen HUD giu dong
                    -- "[km34] Melee | ... | thieu Fragments 3126/5000" cua task Melee va nhan vat
                    -- dung yen vo tan (user: "sao cho no dung im vay"). Nay in ro ly do va neu
                    -- dang thieu diem F thi bao huong tiep theo la RAID lay F.
                    local thieuFLf = Dt3ThieuF()
                    SetTask("MainTask", "Level Farm | khong tim thay quai nao trong server nay")
                    SetTask("SubTask", (thieuFLf and ("thieu diem F " .. tostring(thieuFLf.co) .. "/" ..
                        tostring(thieuFLf.can) .. " (" .. tostring(thieuFLf.ten) .. ") -> RAID lay F")
                        ) or "khong co nhiem vu dang chay + bang nhiem vu sea nay khong con quai live")
                    if not Dt3IdleLog or os.time() - Dt3IdleLog > 30 then
                        Dt3IdleLog = os.time()
                        local ds = {}
                        pcall(function()
                            for ten, n in pairs(LiveEnemyCounts()) do
                                if (tonumber(n) or 0) > 0 then
                                    table.insert(ds, tostring(ten) .. " x" .. tostring(n))
                                end
                            end
                        end)
                        table.sort(ds)
                        print("[DT3] dung yen | q=" .. tostring(hasActiveQuest) .. " | quai live: " ..
                            (#ds > 0 and table.concat(ds, ", ") or "KHONG CO con nao trong server"))
                        if thieuFLf then
                            Dt1Bao("[DT3] khong co quai danh -> lay trai mo RAID lay diem F (" ..
                                tostring(thieuFLf.co) .. "/" .. tostring(thieuFLf.can) .. ")")
                        end
                    end
                end
            end
        )
