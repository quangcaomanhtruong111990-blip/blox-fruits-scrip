                    pcall(function() txt = d.Text end)
                    if type(txt) == "string" and #txt < 90 then
                        nhan[#nhan + 1] = d
                    end
                end
            end
            for _, lbl in ipairs(nhan) do
                local compact = MaterialCompact(lbl.Text)
                for name, key in pairs(want) do
                    if not got[name] and compact == key then
                        local a = lbl.Parent
                        -- CHI tim trong 2 cap cha gan nhat = trong vong 1 o. Len toi 3-4
                        -- cap la ca grid, so dau tien tim thay co the cua o KHAC.
                        for _ = 1, 2 do
                            if not a then
                                break
                            end
                            for _, s in ipairs(a:GetDescendants()) do
                                local isT = false
                                pcall(function() isT = s:IsA("GuiText") end)
                                if isT and s ~= lbl then
                                    local n = tonumber(string.match(tostring(s.Text), "^%s*(%d+)%s*$"))
                                    if n then
                                        got[name] = n
                                        src[name] = "Stash-ten"
                                        break
                                    end
                                end
                            end
                            if got[name] then
                                break
                            end
                            a = a.Parent
                        end
                    end
                end
            end
        end

        function Dt4TruyVan(name)
            local out = { tostring(name) }
            local a = string.match(tostring(name), "^(%S+)")
            local b = string.match(tostring(name), "(%S+)$")
            if a and a ~= name then
                out[#out + 1] = a
            end
            if b and b ~= name and b ~= a then
                out[#out + 1] = b
            end
            return out
        end

        -- (b) Loc tung ten qua o Search roi doc so con lai
        function Dt4LocBang(sg, tb, want, got, src)
            local goc = nil
            pcall(function() goc = tb.Text end)
            Dt4GocText = goc
            local function Dat(s)
                pcall(function() tb.Text = tostring(s or "") end)
                task.wait(0.45)
            end

            -- Do 1 lan/inject: o search CO loc that khong (go "zzz" -> phai ra 0 o)
            if Dt4SearchChay == nil then
                local truoc = #Dt4DemBadge(sg)
                Dat("zzz")
                local sau = #Dt4DemBadge(sg)
                Dat(goc)
                if truoc == 0 then
                    return
                end
                Dt4SearchChay = (sau == 0)
                Dt4SoO = truoc
                print("[DT4] do o search: " .. truoc .. " o luc khong loc -> " .. sau ..
                    " o khi go 'zzz' = " .. (Dt4SearchChay and "SEARCH LOC DUOC" or "SEARCH KHONG LOC, bo qua DT4"))
            end
            if Dt4SearchChay ~= true then
                return
            end

            local ket = {}
            local daGiam = false
            for name in pairs(want) do
                if not got[name] then
                    local k = { so = nil, coKhop = false }
                    for _, q in ipairs(Dt4TruyVan(name)) do
                        Dat(q)
                        local ds = Dt4DemBadge(sg)
                        -- #ds == Dt4SoO (va bang co nhieu hon 1 o) nghia la go gi cung
                        -- con nguyen so o => o search KHONG he loc. Vo nghia, KHONG duoc
                        -- phep rut ra ket luan "co 0" tu do.
                        local khongLoc = ((Dt4SoO or 0) > 1 and #ds == Dt4SoO)
                        if not khongLoc then
                            if #ds < (Dt4SoO or 0) then
                                daGiam = true
                            end
                            if #ds >= 1 then
                                k.coKhop = true
                            end
                            if #ds == 1 then
                                k.so = ds[1]
                                break
                            end
                        end
                    end
                    ket[name] = k
                end
            end
            Dat(goc)
            if not daGiam and (Dt4SoO or 0) > 1 then
                Dt4SearchChay = false
                print("[DT4] ca 4 truy van deu giu nguyen " .. tostring(Dt4SoO) ..
                    " o => o search khong loc duoc bang, TAT DT4 (khong ghi 0 gia)")
                return
            end

            local coAiKhop = false
            for _, k in pairs(ket) do
                if k.coKhop then
                    coAiKhop = true
                    break
                end
            end
            for name, k in pairs(ket) do
                if k.so then
                    got[name] = k.so
                    src[name] = "Stash-search"
                elseif coAiKhop then
                    got[name] = 0
                    src[name] = "Stash-khongco"
                end
            end
            if not coAiKhop and next(ket) ~= nil then
                Dt4KhongKhopTick = Dt4KhongKhopTick or 0
                if os.clock() - Dt4KhongKhopTick > 90 then
                    Dt4KhongKhopTick = os.clock()
                    Dt1Bao("[DT4] search loc duoc bang nhung ca 4 ten Fish Tail / Dragon Scale / Magma Ore" ..
                        " / Mystic Droplet deu khong khop => bang dang dung ten TIENG VIET")
                end
            end
        end

        -- [DT5] ---- NHAN DIEN BANG "VAT PHAM" KHONG CAN O SEARCH + DUMP Cay GUI
        -- DT4 chi tim duoc bang khi no co TextBox "search", va chi doc nhan CHU.
        -- DT5 them 3 thu: (1) nhan dien bang theo luong ICON + CHU SO (khong can
        -- o search), (2) doc ten mon nam trong NAME cua o / GetAttributes() /
        -- StringValue (km55 va km49 deu bo sot duong nay), (3) NEU van khong thay
        -- thi DUMP toan bo cay GUI cua bang len man hinh de chup anh - day la bang
        -- chung duy nhat cho biet ten that cua nguyen lieu nam o dau.
        function Dt5DemO(sg)
            local soIcon, soSo = 0, 0
            for _, d in ipairs(sg:GetDescendants()) do
                local isI = false
                pcall(function() isI = d:IsA("GuiImage") end)
                if isI then
                    local im = nil
                    pcall(function() im = d.Image end)
                    if type(im) == "string" and string.find(im, "rbxasset", 1, true) ~= nil then
                        soIcon = soIcon + 1
                    end
                end
                local isT = false
                pcall(function() isT = d:IsA("GuiText") end)
                if isT then
                    local txt = nil
                    pcall(function() txt = d.Text end)
                    if tonumber(string.match(tostring(txt), "^%s*(%d+)%s*$")) then
                        soSo = soSo + 1
                    end
                end
            end
            return soIcon, soSo
        end

        function Dt5TimOSearch(sg)
            for _, d in ipairs(sg:GetDescendants()) do
                if d:IsA("TextBox") and Dt4DangHien(d) then
                    local k1 = MaterialCompact(d.PlaceholderText)
                    local k2 = MaterialCompact(d.Name)
                    if k1 == "search" or k2 == "search" or k1 == "tim" or k1 == "timkiem"
                        or string.find(k1, "search", 1, true) ~= nil then
                        return d
                    end
                end
            end
            return nil
        end

        -- ScreenGui cua game co >=3 icon va >=2 chu so = bang vat pham dang mo
        function Dt5TimBangMo()
            local best = nil
            -- [DT6] Quet PlayerGui (de quy) + CoreGui (con truc tiep) chu khong rieng
            -- PlayerGui:GetChildren(): nhieu ban nhieu cua nam sau Folder con, va co
            -- ban executor day GUI cua game ra CoreGui.
            for _, sg in ipairs(Dt6CuaAll()) do
                if not Dt4GuiCuaMinh(sg) and Dt4DangHien(sg) then
                    local nd = 0
                    pcall(function() nd = #sg:GetDescendants() end)
                    if nd >= 6 and nd <= 6000 then
                        local soIcon, soSo = Dt5DemO(sg)
                        if soIcon >= 3 and soSo >= 2 and (not best or soIcon > best.icon) then
                            best = { sg = sg, icon = soIcon, so = soSo }
                        end
                    end
                end
            end
            if not best then
                return nil
            end
            local tb = nil
            pcall(function() tb = Dt5TimOSearch(best.sg) end)
            return best.sg, tb, best.icon, best.so
        end

        -- (DT5.2) Ten mon trong NAME / attribute / Value cua chu, roi lay so trong o
        function Dt5DocDinhDanh(sg, want, got, src)
            for _, d in ipairs(sg:GetDescendants()) do
                local tenKhop = nil
                local dn = MaterialCompact(d.Name)
                for name, key in pairs(want) do
                    if not got[name] and dn == key then
                        tenKhop = name
                    end
                end
                if not tenKhop then
                    local okA, attrs = pcall(function() return d:GetAttributes() end)
                    if okA and type(attrs) == "table" then
                        for _, av in pairs(attrs) do
                            if type(av) == "string" then
                                local ka = MaterialCompact(av)
                                for name, key in pairs(want) do
                                    if not got[name] and ka == key then
                                        tenKhop = name
                                    end
                                end
                            end
                        end
                    end
                end
                if not tenKhop then
                    local cv = nil
                    pcall(function() cv = d.Value end)
                    if type(cv) == "string" then
                        local kv = MaterialCompact(cv)
                        for name, key in pairs(want) do
                            if not got[name] and kv == key then
                                tenKhop = name
                            end
                        end
                    end
                end
                if tenKhop then
                    local a = d.Parent
                    for _ = 1, 2 do
                        if not a then
                            break
                        end
                        for _, s in ipairs(a:GetDescendants()) do
                            local isT = false
                            pcall(function() isT = s:IsA("GuiText") end)
                            if isT then
                                local n = tonumber(string.match(tostring(s.Text), "^%s*(%d+)%s*$"))
                                if n then
                                    got[tenKhop] = n
                                    src[tenKhop] = "Stash-dinhdanh"
                                    break
                                end
                            end
                        end
                        if got[tenKhop] then
                            break
                        end
                        a = a.Parent
                    end
                end
            end
        end

        -- (DT5.3) Dump cay GUI: depth | ClassName | 'Ten' | T=chu | I=asset | @thuoc tinh
        function Dt5LayDump(sg)
            local lines = {}
            local function quy(d, cap)
                if #lines >= 150 then
                    return
                end
                local s = string.rep(" ", cap * 2) .. d.ClassName .. "|'" .. tostring(d.Name) .. "'"
                local isT = false
                pcall(function() isT = d:IsA("GuiText") end)
                if isT then
                    local txt = nil
                    pcall(function() txt = d.Text end)
                    if type(txt) == "string" and txt ~= "" then
                        s = s .. " T=" .. string.sub(txt, 1, 24)
                    end
                end
                local isI = false
                pcall(function() isI = d:IsA("GuiImage") end)
                if isI then
                    local im = nil
                    pcall(function() im = d.Image end)
                    if type(im) == "string" and im ~= "" then
                        s = s .. " I=" .. string.gsub(im, "rbxassetid://", "#")
                    end
                end
                local okA, attrs = pcall(function() return d:GetAttributes() end)
                if okA and type(attrs) == "table" then
                    local n = 0
                    for k, v in pairs(attrs) do
                        n = n + 1
                        if n <= 2 then
                            s = s .. " @" .. tostring(k) .. "=" .. tostring(v)
                        end
                    end
                    if n > 2 then
                        s = s .. " @" .. n .. "attr"
                    end
                end
                local cv = nil
                pcall(function() cv = d.Value end)
                if cv ~= nil then
                    s = s .. " V=" .. tostring(cv)
                end
                if #s > 116 then
                    s = string.sub(s, 1, 116)
                end
                table.insert(lines, s)
                for _, c in ipairs(d:GetChildren()) do
                    quy(c, cap + 1)
                end
            end
            quy(sg, 0)
            return lines
        end

