        function Dt4DocBang(want, got, src)
            local sg, tb, soIcon, soSo = Dt5TimBangMo()
            if not sg then
                return false
            end
            Dt5DaThay = true
            Dt5Dumped = Dt5Dumped or {}
            local moc = tostring(sg.Name)
            if not Dt5Bao or Dt5Bao ~= moc then
                Dt5Bao = moc
                Dt1Bao("[DT5] THAY bang Vat Pham '" .. moc .. "': " .. soIcon .. " icon, " .. soSo ..
                    " chu so, o search = " .. (tb and "CO" or "KHONG") .. " -> dang doc")
            end
            pcall(Dt5DocDinhDanh, sg, want, got, src)
            Dt4DocTheoTen(sg, want, got, src)
            local con = false
            for name in pairs(want) do
                if not got[name] then
                    con = true
                    break
                end
            end
            if con and tb then
                Dt4LocBang(sg, tb, want, got, src)
            end
            local con2 = false
            for name in pairs(want) do
                if not got[name] then
                    con2 = true
                    break
                end
