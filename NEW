        function QuestManager.RefreshQuest(Self)
            pcall(function()
                local retries = 0
                while not (ScriptStorage and ScriptStorage.PlayerData and ScriptStorage.PlayerData.Level) do
                    pcall(RefreshPlayerData)
                    if not (ScriptStorage and ScriptStorage.PlayerData and ScriptStorage.PlayerData.Level) then
                        local lp = game:GetService("Players").LocalPlayer
                        if lp and lp:FindFirstChild("Data") and lp.Data:FindFirstChild("Level") then
                            if not ScriptStorage.PlayerData then ScriptStorage.PlayerData = {} end
                            ScriptStorage.PlayerData.Level = lp.Data.Level.Value
                        end
                    end
                    if ScriptStorage and ScriptStorage.PlayerData and ScriptStorage.PlayerData.Level then break end
                    task.wait(0.2)
                    retries = retries + 1
                    if retries > 15 then
                        if not ScriptStorage.PlayerData then ScriptStorage.PlayerData = {} end
                        ScriptStorage.PlayerData.Level = 1
                        break
                    end
                end

                local PlayerLevelM1 = (ScriptStorage and ScriptStorage.PlayerData and ScriptStorage.PlayerData.Level) or 1
                local DaiBien = QuestManager.BienTheoSea[SeaIndex] or { Min = 0, Max = 99999 }

                -- [M1] CHON NHIEM VU TRONG BIEN DANG DUNG.
                -- Ban cu: "LevelReq cao nhat <= level" khong loc bien -> acc Level 1590
                -- dang o Sea 2 lay AmazonQuest (1575 = Sea 3, NPC o 5833,52,-1103),
                -- bay toi toa do Sea 3 trong khi ban do o Sea 2 khong ton tai -> buoc
                -- "CaculateDistance > 10 thi return" luon luon dung -> StartQuest
                -- khong bao gio duoc goi = khong nhan duoc nhiem vu + di sai bai quai.
                local function ChonNhiemVu(chonCao, chanLevel)
                    local ketQua = nil
                    if not (QuestManager and QuestManager.Quests) then
                        return nil
                    end
                    for QuestID, QuestDatas in pairs(QuestManager.Quests) do
                        if not (QuestManager.BlacklistedQuestIds and QuestManager.BlacklistedQuestIds[QuestID]) then
                            local lr = QuestDatas and QuestDatas[1] and tonumber(QuestDatas[1].LevelReq)
                            if lr and lr >= DaiBien.Min and lr <= DaiBien.Max then
                                if chanLevel and lr > PlayerLevelM1 then
                                    lr = nil
                                end
                            else
                                lr = nil
                            end
                            if lr and (not ketQua
                                or (chonCao and lr >= ketQua.LevelReq)
                                or (not chonCao and lr < ketQua.LevelReq)) then
                                ketQua = { Id = QuestID, Data = QuestDatas, LevelReq = lr }
                            end
                        end
                    end
                    return ketQua
                end

                local DaChon = ChonNhiemVu(true, true)
                if not DaChon then
                    -- Bien nay chua co nhiem vu ma Level hinh da toi (vi du Level 800
                    -- ma dang o Sea 3): lay nhiem vu THAP NHAT cua chinh bien do, van
                    -- khong nhay sang bien khac.
                    DaChon = ChonNhiemVu(false, false)
                    if DaChon then
                        BaoM1("[M1] Bien " .. tostring(SeaIndex) .. " (can LevelReq " ..
                            tostring(DaiBien.Min) .. "-" .. tostring(DaiBien.Max) ..
                            ") chua co nhiem vu duoc cho Level " .. tostring(PlayerLevelM1) ..
                            " -> tam danh [ID] " .. tostring(DaChon.Id) ..
                            " (can " .. tostring(DaChon.LevelReq) .. ")")
                    end
                end

                local QuestLevelFlag = DaChon and DaChon.LevelReq or 0
                local CurrentQuestData = DaChon and DaChon.Data or nil
                if DaChon then
                    Self.CurrentQuestId = DaChon.Id
                else
                    Self.CurrentQuestId = nil
                    BaoM1("[M1] KHONG co nhiem vu nao trong bien " .. tostring(SeaIndex) ..
                        " (dai 0-" .. DaiBien.Max .. "), Level " .. PlayerLevelM1 ..
                        " -> kiem tra SeaIndex / danh sach quest")
                end
                Self.CurrentQuestLevelReq = QuestLevelFlag

                -- [M1] XOA toa do NPC CU. Ban cu chi GAN Self.CurrentNpc luc TIM THAY
                -- chu KHONG BAO GIO xoa -> doi nhiem vu ma NpcList/BuiltIn khong khop thi
                -- nhan vat van bay toi NPC cua nhiem vu TRUOC (mot trong ly do "di sai bai").
                Self.CurrentNpc = nil

                if CurrentQuestData and #CurrentQuestData > 0 then
                    local LastQuest = CurrentQuestData[#CurrentQuestData]
                    if LastQuest and LastQuest.Task then
                        for _, Count in pairs(LastQuest.Task) do
                            if Count == 1 then
                                table.remove(CurrentQuestData, #CurrentQuestData)
                            end
                        end
                    end

                    -- [M1] Lay toa do NPC cua DUNG muc ma GetCurrentQuest se tra ten quai
                    -- (muc 2 neu LevelReq muc do <= Level, nguoc lai muc 1). Ban cu luon
                    -- dung muc CUOI -> co khi toa do NPC o mot dao con ten quai o dao khac.
                    local MucChon = 1
                    local n = tonumber(Self.CurrentLevel) or 1
                    local muc = CurrentQuestData[n]
                    if muc and tonumber(muc.LevelReq)
                        and muc.LevelReq <= (ScriptStorage.PlayerData and ScriptStorage.PlayerData.Level or 1) then
                        MucChon = n
                    end
                    Self.M1MucChon = MucChon

                    -- 1. Try GuideModule / NpcList
                    if NpcList and CurrentQuestData[MucChon] then
                        for i, v in pairs(NpcList) do
                            if v and v.Levels then
                                for _, v1 in pairs(v.Levels) do
                                    if v1 == CurrentQuestData[MucChon].LevelReq then
                                        if typeof(i) == "Instance" then
                                            Self.CurrentNpc = (i:IsA("Model") and i:GetPivot().Position) or (i:IsA("BasePart") and i.Position)
                                        elseif typeof(i) == "CFrame" then
                                            Self.CurrentNpc = i.Position
                                        elseif typeof(i) == "Vector3" then
                                            Self.CurrentNpc = i
                                        elseif typeof(i) == "string" then
                                            local npcObj = (workspace:FindFirstChild("NPCs") and workspace.NPCs:FindFirstChild(i)) or (game.ReplicatedStorage:FindFirstChild("NPCs") and game.ReplicatedStorage.NPCs:FindFirstChild(i))
                                            if npcObj then
                                                Self.CurrentNpc = (npcObj:IsA("Model") and npcObj:GetPivot().Position) or (npcObj:IsA("BasePart") and npcObj.Position)
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end

                    -- 2. Fallback Built-in NPC Coordinates
                    if not Self.CurrentNpc and Self.CurrentQuestId and BuiltInNpcPositions[Self.CurrentQuestId] then
                        Self.CurrentNpc = BuiltInNpcPositions[Self.CurrentQuestId]
                    end
                end

                Self.CurrentQuests = CurrentQuestData
                Self:M1LogChon()
            end)
        end

        function QuestManager.GetCurrentQuest(Self)
            if not Self.CurrentQuests or #Self.CurrentQuests == 0 then
                return nil, nil, nil, 1, nil
            end
            local QuestIndex =
                Self.CurrentQuests[Self.CurrentLevel] and
                Self.CurrentQuests[Self.CurrentLevel].LevelReq <= (ScriptStorage.PlayerData and ScriptStorage.PlayerData.Level or 1) and
                Self.CurrentLevel or
                1

            if Self.CurrentQuests[QuestIndex] and Self.CurrentQuests[QuestIndex].Task then
                for Name in Self.CurrentQuests[QuestIndex].Task do
                    return Name, Self.CurrentNpc, Self.CurrentQuestId, QuestIndex, Self.CurrentQuests[QuestIndex].Name
                end
            end
            return nil, Self.CurrentNpc, Self.CurrentQuestId, 1, nil
        end

